--- HPKBUILD
+++ HPKBUILD
@@ -70,6 +70,24 @@ build() {
     cp -r $LYCIUM_ROOT/usr/live555/$ARCH/include  $builddir/$ARCH-contrib
     cp -r $LYCIUM_ROOT/usr/live555/$ARCH/lib  $builddir/$ARCH-contrib
+
+    # MPEG-TS demux is conditional on libdvbpsi. Build the dependency from
+    # VLC's pinned contrib source so clean builds always ship libts.
+    local contrib_tools="$PWD/$builddir/$ARCH-contrib-tools"
+    mkdir -p "$contrib_tools/bin" "$contrib_tools/share/automake-vlc"
+    cp "$builddir/autotools/config.sub" "$builddir/autotools/config.guess" \
+        "$contrib_tools/share/automake-vlc/"
+    (
+        export PATH="$contrib_tools/bin:$PATH"
+        mkdir -p "$builddir/$ARCH-contrib-build"
+        cd "$builddir/$ARCH-contrib-build"
+        ../contrib/bootstrap \
+            --build="$(../autotools/config.guess)" \
+            --host=$host \
+            --prefix="../$ARCH-contrib" \
+            --enable-dvbpsi || exit $?
+        $MAKE .dvbpsi
+    ) || return $?
     local ffmpeg_prefix="$LYCIUM_ROOT/usr/FFmpeg/arm64-v8a"
     export PKG_CONFIG_LIBDIR="${pkgconfigpath}:${ffmpeg_prefix}/lib/pkgconfig"
