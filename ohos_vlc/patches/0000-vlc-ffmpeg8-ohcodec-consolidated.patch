 /****************************************************************************
  * OpenVCDImage: try to open a vcd image from a .cue file
  ****************************************************************************/
+static int ReadIsoSector( int i_fd, uint32_t i_lba, uint8_t *p_buf )
+{
+    if( lseek( i_fd, (off_t)i_lba * 2048, SEEK_SET ) < 0 )
+        return -1;
+    return read( i_fd, p_buf, 2048 ) == 2048 ? 0 : -1;
+}
+
+/* FindIsoDirEntry: 在 ISO9660 目录里查找条目。
+ * b_prefix 为 true 时 psz_name 作前缀匹配(如 "AVSEQ");
+ * b_directory 限定只匹配目录(MPEGAV)或只匹配文件(AVSEQ*.DAT);
+ * 找到后回填 extent/size(逻辑块号/字节数),返回 0;否则 -1。 */
+static int FindIsoDirEntry( int i_fd, uint32_t i_extent, uint32_t i_size,
+                            const char *psz_name, bool b_prefix,
+                            bool b_directory, uint32_t *pi_extent,
+                            uint32_t *pi_size )
+{
+    uint8_t p_sector[2048];
+    uint32_t i_off = 0;
+
+    while( i_off + 33 <= i_size )
+    {
+        uint32_t i_sec_off = i_off % 2048;
+        if( i_sec_off == 0 )
+        {
+            if( ReadIsoSector( i_fd, i_extent + i_off / 2048, p_sector ) )
+                return -1;
+        }
+
+        uint8_t i_rec_len = p_sector[i_sec_off];
+        if( i_rec_len == 0 )
+            break; /* 目录数据结束(剩余为零填充) */
+
+        /* ISO9660 目录记录不得跨 sector 边界;遇边界跳到下一 sector 起始 */
+        if( i_sec_off + i_rec_len > 2048 )
+        {
+            i_off = ( i_off / 2048 + 1 ) * 2048;
+            continue;
+        }
+        if( i_rec_len < 33 )
+        {
+            i_off += i_rec_len;
+            continue;
+        }
+
+        uint32_t i_entry_extent = GetDWLE( &p_sector[i_sec_off + 2] );
+        uint32_t i_entry_size   = GetDWLE( &p_sector[i_sec_off + 10] );
+        uint8_t  i_flags        = p_sector[i_sec_off + 25];
+        uint8_t  i_name_len     = p_sector[i_sec_off + 32];
+        bool     b_is_dir       = ( i_flags & 0x02 ) != 0;
+
+        if( b_is_dir == b_directory && i_name_len > 0 && i_name_len < 64 )
+        {
+            char psz_entry[64];
+            memcpy( psz_entry, &p_sector[i_sec_off + 33], i_name_len );
+            psz_entry[i_name_len] = '\0';
+            char *p_semi = strchr( psz_entry, ';' );
+            if( p_semi ) *p_semi = '\0';
+
+            bool b_match = b_prefix ? !strncasecmp( psz_entry, psz_name,
+                                                    strlen( psz_name ) )
+                                    : !strcasecmp( psz_entry, psz_name );
+            if( b_match )
+            {
+                *pi_extent = i_entry_extent;
+                *pi_size = i_entry_size;
+                return 0;
+            }
+        }
+        i_off += i_rec_len;
+    }
+    return -1;
+}
