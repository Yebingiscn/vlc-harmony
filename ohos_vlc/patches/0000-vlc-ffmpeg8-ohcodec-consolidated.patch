+/* OpenVCDImageIso9660: 无 .cue 时直接解析 ISO9660 映像,把 MPEGAV/AVSEQ*.DAT
+ * 文件的 extent 作为视频轨起点(2048 字节 Mode1 扇区,payload 占满整扇区)。
+ * 成功返回 0 并填充 p_vcddev(含打开的映像句柄与 TOC);失败返回 -1。 */
+static int OpenVCDImageIso9660( vlc_object_t *p_this, const char *psz_vcdfile,
+                                vcddev_t *p_vcddev )
+{
+    uint8_t p_pvd[2048];
+    uint32_t i_root_extent, i_root_size;
+    uint32_t i_mpegav_extent = 0, i_mpegav_size = 0;
+    uint32_t i_avseq_extent = 0, i_avseq_size = 0;
+    vcddev_toc_t *p_toc = &p_vcddev->toc;
+
+    p_vcddev->i_vcdimage_handle = vlc_open( psz_vcdfile,
+                                            O_RDONLY | O_NONBLOCK | O_BINARY );
+    if( p_vcddev->i_vcdimage_handle == -1 )
+        return -1;
+
+    /* PVD 位于逻辑块 16;校验 ISO9660 魔数 */
