+
+    msg_Dbg( p_this, "vcd iso9660 tracks: data=0 video=%u end=%u",
+             i_avseq_extent, p_toc->p_sectors[2].i_lba );
+    return 0;
+
+error:
+    vlc_close( p_vcddev->i_vcdimage_handle );
+    p_vcddev->i_vcdimage_handle = -1;
+    return -1;
+}
