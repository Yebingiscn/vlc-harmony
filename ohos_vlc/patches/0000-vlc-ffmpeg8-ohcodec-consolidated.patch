+    msg_Dbg( p_this, "no .cue file: ISO9660 MPEGAV dir at sector %u, "
+             "AVSEQ video file at sector %u size %u",
+             i_mpegav_extent, i_avseq_extent, i_avseq_size );
+
+    /* ISO9660(MODE1/2048):payload 占满整个 2048 字节扇区 */
+    p_vcddev->i_sector_size = 2048;
+    p_vcddev->i_data_start = 0;
+    p_vcddev->i_data_size = 2048;
