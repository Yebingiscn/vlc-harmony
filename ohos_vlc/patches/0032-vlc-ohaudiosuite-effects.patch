+/* Per player, independent of "audio-filter" (which the equalizer rewrites). */
+LIBVLC_API int libvlc_media_player_get_ohos_audio_effect_max_preset(void)
+{
+    return VLC_OHOS_EFFECT_MAX;
+}
+
+LIBVLC_API int libvlc_media_player_set_ohos_audio_effect(libvlc_media_player_t *mp, int preset)
+{
+    if (preset < 0 || preset > VLC_OHOS_EFFECT_MAX)
+        return -1;
+    return var_SetInteger(mp, VLC_OHOS_EFFECT_VAR, preset) == VLC_SUCCESS ? 0 : -1;
+}
+
+LIBVLC_API int libvlc_media_player_get_ohos_audio_effect_status(libvlc_media_player_t *mp)
+{
+    int preset = var_GetInteger(mp, VLC_OHOS_EFFECT_VAR);
+    if (preset == 0)
+        return 0;
+    audio_output_t *aout = input_resource_HoldAout(mp->input.p_resource);
+    if (aout == NULL)
+        return 1;
+    int value = var_GetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR);
+    vlc_object_release(aout);
+    return value / 4 == preset ? value % 4 : 1;
+}
