 /* Description of the module */
 static int  Open(vlc_object_t *);
@@ -121,8 +122,65 @@ struct aout_sys_t {
     vlc_tick_t last_write_time;
     size_t max_queue_size;
     bool flushed_since_play;
+    /* Play/Start/Flush/Stop are serialized under VLC's output lock.
+     * The system write callback never touches this graph. */
+    ohos_audio_effects *suite;
+    int suite_preset;
+    bool suite_stereo;
+    bool suite_rendered;
 };
 
+static vlc_tick_t vlc_tick_from_samples(uint64_t samples, uint32_t sample_rate);
+
+static void ResetEffects(audio_output_t *aout)
+{
+    aout_sys_t *s = aout->sys;
+    ohos_effects_close(s->suite);
+    s->suite = NULL;
+    s->suite_preset = 0;
+    s->suite_rendered = false;
+    var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, 0);
+}
+
+static const uint8_t *ApplyEffects(audio_output_t *aout, const block_t *block)
+{
+    aout_sys_t *s = aout->sys;
+    int preset = var_InheritInteger(aout, VLC_OHOS_EFFECT_VAR);
+    if (s->suite_preset != preset) {
+        ResetEffects(aout);
+        s->suite_preset = preset;
+        if (preset != 0) {
+            ohos_pcm_type type = s->sample_format == AUDIOSTREAM_SAMPLE_S16LE ? OHOS_PCM_S16 :
+                                 s->sample_format == AUDIOSTREAM_SAMPLE_S32LE ? OHOS_PCM_S32 : OHOS_PCM_FLOAT;
+            if (s->suite_stereo)
+                s->suite = ohos_effects_open(preset, s->sample_rate, type);
+            if (!s->suite) {
+                msg_Dbg(aout, "AudioSuite preset %d unavailable for this output; using original PCM", preset);
+                var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 3);
+            }
+        }
+    }
+    if (!s->suite)
+        return block->p_buffer;
+
+    const vlc_tick_t start = mdate();
+    const uint8_t *pcm = ohos_effects_render(s->suite, block->p_buffer, block->i_buffer);
+    const vlc_tick_t block_time = vlc_tick_from_samples(block->i_nb_samples, s->sample_rate);
+    if (!pcm || mdate() - start > __MAX(block_time, VLC_TICK_FROM_MS(8))) {
+        msg_Warn(aout, "AudioSuite preset %d render failed or exceeded its time budget; using original PCM", preset);
+        ohos_effects_close(s->suite);
+        s->suite = NULL;
+        var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 3);
+        return block->p_buffer;
+    }
+    if (!s->suite_rendered) {
+        s->suite_rendered = true;
+        var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 2);
+        msg_Dbg(aout, "AudioSuite playback effect active: preset %d", preset);
+    }
+    return pcm;
+}
