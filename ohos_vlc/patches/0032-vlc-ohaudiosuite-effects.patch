+static vlc_tick_t vlc_tick_from_samples(uint64_t samples, uint32_t sample_rate);
+
+static void ResetEffects(audio_output_t *aout)
+{
+    aout_sys_t *s = aout->sys;
+    ohos_effects_close(s->suite);
+    s->suite = NULL;
+    s->suite_preset = 0;
+    s->suite_rendered = false;
+    var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, 0);
+}
+
+static void QueuePCM(audio_output_t *aout, const uint8_t *pcm, size_t bytes);
+
+static void QueueDryEffectTail(audio_output_t *aout)
+{
+    ohos_audio_effects *suite = aout->sys->suite;
+    while (ohos_effects_pending(suite) > 0) {
+        size_t bytes;
+        const uint8_t *pcm = ohos_effects_dry(suite, &bytes);
+        QueuePCM(aout, pcm, bytes);
+        ohos_effects_consume(suite, bytes);
+    }
+}
+
+/* True means the bridge has handled the block; it need not be queued again. */
+static bool ApplyEffects(audio_output_t *aout, const block_t *block)
+{
+    aout_sys_t *s = aout->sys;
+    int preset = var_InheritInteger(aout, VLC_OHOS_EFFECT_VAR);
+    if (s->suite_preset != preset && ohos_effects_select_stem(s->suite, preset)) {
+        s->suite_preset = preset;
+        s->suite_rendered = false;
+    } else if (s->suite_preset != preset) {
+        QueueDryEffectTail(aout);
+        ResetEffects(aout);
+        s->suite_preset = preset;
+        if (preset != 0) {
+            ohos_pcm_type type = s->sample_format == AUDIOSTREAM_SAMPLE_S16LE ? OHOS_PCM_S16 :
+                                 s->sample_format == AUDIOSTREAM_SAMPLE_S32LE ? OHOS_PCM_S32 : OHOS_PCM_FLOAT;
+            if (s->suite_stereo)
+                s->suite = ohos_effects_open(preset, s->sample_rate, type);
+            if (!s->suite) {
+                msg_Dbg(aout, "AudioSuite preset %d unavailable (%u Hz, %u channels, format %d); using original PCM",
+                        preset, s->sample_rate, s->channels, (int)s->sample_format);
+                var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 3);
+            }
+        }
+    }
+    if (!s->suite)
+        return false;
+
+    bool accepted = ohos_effects_feed(s->suite, block->p_buffer, block->i_buffer);
+    if (accepted) {
+        const vlc_tick_t budget = __MAX(vlc_tick_from_samples(block->i_nb_samples, s->sample_rate),
+                                      VLC_TICK_FROM_MS(20));
+        vlc_tick_t spent = 0;
+        for (;;) {
+            const uint8_t *pcm;
+            size_t bytes;
+            ohos_effect_report report;
+            vlc_tick_t start = mdate();
+            ohos_effect_result result = ohos_effects_render(s->suite, &pcm, &bytes, &report);
+            spent += mdate() - start;
+            if (result == OHOS_EFFECT_ERROR || (report.requested != 0 && spent > budget)) {
+                msg_Warn(aout, "AudioSuite preset %d bypassed: %s (rc=%d, requested=%zu, "
+                         "returned=%d, pulled=%zu, padded=%zu, pending=%zu, finished=%d, "
+                         "render=%" PRId64 " us, budget=%" PRId64 " us); using original PCM",
+                         preset, result == OHOS_EFFECT_ERROR ? report.reason : "render budget exceeded",
+                         report.status, report.requested, (int)report.returned, report.pulled,
+                         report.padded, ohos_effects_pending(s->suite), (int)report.finished,
+                         spent, budget);
+                break;
+            }
+            if (result == OHOS_EFFECT_WAIT)
+                return true;
+
+            QueuePCM(aout, pcm, bytes);
+            ohos_effects_consume(s->suite, bytes);
+            if (!s->suite_rendered) {
+                s->suite_rendered = true;
+                var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 2);
+                msg_Dbg(aout, "AudioSuite playback effect active: preset %d (%u Hz, "
+                        "requested=%zu, returned=%zu, pulled=%zu)",
+                        preset, s->sample_rate, report.requested, bytes, report.pulled);
+            }
+        }
+    } else {
+        msg_Warn(aout, "AudioSuite preset %d bypassed: PCM input not buffered "
+                 "(block=%zu, pending=%zu); using original PCM",
+                 preset, block->i_buffer, ohos_effects_pending(s->suite));
+    }
+    QueueDryEffectTail(aout);
+    ohos_effects_close(s->suite);
+    s->suite = NULL;
+    var_SetInteger(aout, VLC_OHOS_EFFECT_STATUS_VAR, preset * 4 + 3);
+    return accepted;
+}
