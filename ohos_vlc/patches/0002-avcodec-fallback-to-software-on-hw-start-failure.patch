From: vlc-harmony maintainers
Subject: [PATCH] avcodec: fall back to software decoder when OHOS HW decoder fails to start

The OHOS MediaCodec-backed decoders can exist but still fail avcodec_open2()
(for example for an unsupported profile, level or buffer geometry). Retry the
same video decoder setup once with FFmpeg's software decoder instead of
leaving playback on a black frame.

diff --git a/modules/codec/avcodec/video.c b/modules/codec/avcodec/video.c
--- a/modules/codec/avcodec/video.c
+++ b/modules/codec/avcodec/video.c
@@ -510,5 +510,34 @@ static int OpenVideoCodec( decoder_t *p_dec )
     post_mt( p_sys );
     ret = ffmpeg_OpenCodec( p_dec, ctx, codec );
     wait_mt( p_sys );
+#ifdef HAVE_OHOS
+    if( ret < 0 && codec->name != NULL &&
+        strstr( codec->name, "ohosavcodec" ) != NULL )
+    {
+        const AVCodec *fallback = avcodec_find_decoder( codec->id );
+        if( fallback != NULL && fallback != codec )
+        {
+            msg_Warn( p_dec, "OHOS hardware decoder %s failed to start; "
+                      "falling back to software decoder %s",
+                      codec->name, fallback->name );
+
+            /* avcodec_open2() has closed its failed private state. The
+             * NativeWindow context is owned by VLC and must be released
+             * before retrying a non-OHOS decoder on the same AVCodecContext. */
+            if( ctx->hwaccel_context != NULL )
+                av_ohosavcodec_default_free( ctx );
+            ctx->pix_fmt = AV_PIX_FMT_NONE;
+
+            post_mt( p_sys );
+            ret = ffmpeg_OpenCodec( p_dec, ctx, fallback );
+            wait_mt( p_sys );
+            if( ret >= 0 )
+            {
+                codec = fallback;
+                p_sys->p_codec = fallback;
+            }
+        }
+    }
+#endif
     if( ret < 0 )
         return ret;
