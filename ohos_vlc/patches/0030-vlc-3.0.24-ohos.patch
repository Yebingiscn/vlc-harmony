+
+#include <hilog/log.h>
+#include <stdarg.h>
+#include <stdio.h>
+
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+
+#define LOG_DOMAIN 0x00
+#define LOG_TAG "VLC"
+static const int ptr_width = 2 * /* hex digits */ sizeof (uintptr_t);
+// The maximum log length is approximately 1.8 kilobytes.
+static void OhosPrintMsg(void *opaque, int type, const vlc_log_t *p_item,
+                            const char *format, va_list ap)
+{
+    int prio;
+    int verbose = (intptr_t)opaque;
+
+    if (verbose < type)
+        return;
+
+    char message[2048] = {0};
+
+    int prefix_len = snprintf(message, sizeof(message), "[%0*"PRIxPTR"/%lx] %s %s: ",
+                             ptr_width, p_item->i_object_id, p_item->tid,
+                             p_item->psz_module, p_item->psz_object_type);
+
+    if (prefix_len > 0 && prefix_len < (int)sizeof(message)) {
+        vsnprintf(message + prefix_len, sizeof(message) - prefix_len, format, ap);
+    }
+    switch (type) {
+        case VLC_MSG_INFO: prio = LOG_INFO;  break;
+        case VLC_MSG_ERR:  prio = LOG_ERROR; break;
+        case VLC_MSG_WARN: prio = LOG_WARN;  break;
+        default:           prio = LOG_DEBUG; break;
+    }
+    OH_LOG_PrintMsg(LOG_APP, prio, LOG_DOMAIN, LOG_TAG, message);
+}
+
+static vlc_log_cb Open(vlc_object_t *obj, void **sysp)
+{
+    int verbosity = var_InheritInteger(obj, "verbose");
+
+    if (verbosity < 0)
+        return NULL;
+
+    verbosity += VLC_MSG_ERR;
+    *sysp = (void *)(uintptr_t)verbosity;
+
+    return OhosPrintMsg;
+}
+
+vlc_module_begin()
+    set_shortname(N_("OpenHarmony log"))
+    set_description(N_("OpenHarmony log using hilog"))
+    set_category(CAT_ADVANCED)
+    set_subcategory(SUBCAT_ADVANCED_MISC)
+    set_capability("logger", 30)
+    set_callbacks(Open, NULL)
+vlc_module_end ()
