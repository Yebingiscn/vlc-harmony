+void* GetOHOSNativeWindow(void* ohos_window)
+{
+    if (ohos_window != NULL) {
+        OHNativeWindow* handle = (OHNativeWindow*)ohos_window;
+        return handle;
+    }
+    return NULL;
+}
+
+OHNativeWindow* NewOHOSWindowHandle(vout_window_t* wnd, uint64_t* width, uint64_t* height)
+{
+    OHNativeWindow* win = var_InheritAddress(wnd, "drawable-ohos-nativewindow-ptr");
+    msg_Dbg(wnd, "[OHOS-DBG] NewOHOSWindowHandle: nativewindow=%p", win);
+    if (win == NULL) {
+        msg_Err(wnd, "[OHOS-DBG] NewOHOSWindowHandle: window ptr is nullptr");
+        return NULL;
+    }
+    int32_t ret = OH_NativeWindow_NativeWindowHandleOpt(win, GET_BUFFER_GEOMETRY, height, width);
+    msg_Dbg(wnd, "[OHOS-DBG] NewOHOSWindowHandle: GET_BUFFER_GEOMETRY ret=%d, width=%llu, height=%llu",
+            ret, (unsigned long long)*width, (unsigned long long)*height);
+    if (ret != 0)
+    {
+        msg_Err(wnd, "[OHOS-DBG] NewOHOSWindowHandle: OH_NativeWindow_NativeWindowHandleOpt failed : ret = %d", ret);
+        return NULL;
+    }
+    return win;
+}
+
