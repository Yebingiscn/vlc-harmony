+ * limitations under the License.
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_vout_display.h>
+#include <vlc_picture_pool.h>
+#include <vlc_filter.h>
+#include <vlc_subpicture.h>
+#include <native_buffer/native_buffer.h>
+#include <native_window/external_window.h>
+#include <errno.h>
+#include <poll.h>
+#include <stdint.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "display.h"
+
+#define POOL_SIZE 30
+
+struct vout_display_sys_t
+{
+    picture_pool_t *pool;
+    bool need_flush;
+    unsigned frame_count;
+    picture_t *last_pic;
+    vlc_tick_t last_date;
+    vlc_tick_t last_present_warning;
+    OHNativeWindow *osd_window;
+    filter_t *osd_blend;
+    unsigned osd_width;
+    unsigned osd_height;
+    int64_t osd_order;
+    bool osd_visible;
+    bool osd_force_upload;
+    vlc_thread_t osd_thread;
+    vlc_mutex_t osd_lock;
+    vlc_cond_t osd_cond;
+    subpicture_t *osd_pending_subpic;
+    bool osd_pending;
+    bool osd_stop;
+    bool osd_thread_started;
+};
+
+static const vlc_fourcc_t subpicture_chromas[] = { VLC_CODEC_RGBA, 0 };
+
+static picture_pool_t *Pool(vout_display_t *vd, unsigned count)
+{
+    vout_display_sys_t *sys = vd->sys;
+
+    if (sys->pool) {
+        msg_Dbg(vd, "[OHOS-DBG] Pool: reusing existing pool, count=%u", count);
+        return sys->pool;
+    }
+
+    if (count > POOL_SIZE)
+        count = POOL_SIZE;
+
+    msg_Dbg(vd, "[OHOS-DBG] Pool: creating pool, requested=%u, capped=%u, fmt=%4.4s %ux%u",
+            count, POOL_SIZE, (char *)&vd->fmt.i_chroma,
+            vd->fmt.i_width, vd->fmt.i_height);
+
+    picture_t *pics[POOL_SIZE];
+    unsigned i;
+    for (i = 0; i < count; i++)
+    {
+        picture_resource_t rsc = { .p_sys = NULL };
+        pics[i] = picture_NewFromResource(&vd->fmt, &rsc);
+        if (!pics[i]) {
+            msg_Err(vd, "[OHOS-DBG] Pool: picture_NewFromResource failed at i=%u", i);
+            break;
+        }
+    }
+
+    if (i == 0) {
+        msg_Err(vd, "[OHOS-DBG] Pool: no pictures allocated");
+        return NULL;
+    }
+
+    sys->pool = picture_pool_New(i, pics);
+    if (!sys->pool)
+    {
+        msg_Err(vd, "[OHOS-DBG] Pool: picture_pool_New failed");
+        while (i > 0)
+            picture_Release(pics[--i]);
+        return NULL;
+    }
+
+    msg_Dbg(vd, "[OHOS-DBG] Pool: created pool with %u pictures", i);
+    return sys->pool;
+}
+
+static bool WaitAndCloseFence(vout_display_t *vd, int fence_fd)
+{
+    if (fence_fd < 0)
+        return true;
+
+    struct pollfd pfd = { .fd = fence_fd, .events = POLLIN };
+    int ret;
+    do
+        ret = poll(&pfd, 1, 3000);
+    while (ret < 0 && errno == EINTR);
+    close(fence_fd);
+    if (ret <= 0)
+    {
+        msg_Warn(vd, "OSD buffer fence wait failed: %s",
+                 ret == 0 ? "timeout" : vlc_strerror_c(errno));
+        return false;
+    }
+    return true;
+}
+
+static bool ConfigureOsdWindow(vout_display_t *vd, OHNativeWindow *window)
+{
+    unsigned width = vd->cfg->display.width;
+    unsigned height = vd->cfg->display.height;
+    if (width == 0 || height == 0)
+    {
+        int queried_width = 0;
+        int queried_height = 0;
+        if (OH_NativeWindow_NativeWindowHandleOpt(
+                window, GET_BUFFER_GEOMETRY,
+                &queried_height, &queried_width) == 0 &&
+            queried_width > 0 && queried_height > 0)
+        {
+            width = queried_width;
+            height = queried_height;
+        }
+    }
+    if (width == 0 || height == 0)
+    {
+        video_format_t rotated;
+        video_format_ApplyRotation(&rotated, &vd->source);
+        width = rotated.i_visible_width
+            ? rotated.i_visible_width : rotated.i_width;
+        height = rotated.i_visible_height
+            ? rotated.i_visible_height : rotated.i_height;
+    }
+    int ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_BUFFER_GEOMETRY, width, height);
+    if (ret != 0)
+    {
+        msg_Err(vd, "failed to set OSD Surface geometry: %d", ret);
+        return false;
+    }
+
+    ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_FORMAT, NATIVEBUFFER_PIXEL_FMT_BGRA_8888);
+    if (ret != 0)
+    {
+        msg_Err(vd, "failed to set OSD Surface format: %d", ret);
+        return false;
+    }
+
+    uint64_t usage = NATIVEBUFFER_USAGE_CPU_WRITE | NATIVEBUFFER_USAGE_CPU_READ;
+    ret = OH_NativeWindow_NativeWindowHandleOpt(window, SET_USAGE, usage);
+    if (ret != 0)
+    {
+        msg_Err(vd, "failed to set OSD Surface CPU usage: %d", ret);
+        return false;
+    }
+    ret = OH_NativeWindow_NativeWindowHandleOpt(
+        window, SET_SOURCE_TYPE, OH_SURFACE_SOURCE_UI);
+    if (ret != 0)
+        msg_Dbg(vd, "failed to mark OSD Surface as UI source: %d", ret);
+    return true;
+}
+
+static bool SyncOsdWindow(vout_display_t *vd)
+{
+    vout_display_sys_t *sys = vd->sys;
+    OHNativeWindow *window = var_InheritAddress(
+        vd, "drawable-ohos-osd-nativewindow-ptr");
+    if (window == sys->osd_window)
+        return window != NULL;
+
+    sys->osd_window = window;
+    sys->osd_visible = false;
+    sys->osd_order = INT64_MIN;
+    sys->osd_force_upload = true;
+    sys->osd_width = 0;
+    sys->osd_height = 0;
+    if (sys->osd_blend)
+    {
+        filter_DeleteBlend(sys->osd_blend);
+        sys->osd_blend = NULL;
+    }
+    if (!window)
+        return false;
+    if (!ConfigureOsdWindow(vd, window))
+    {
+        sys->osd_window = NULL;
+        return false;
+    }
+    msg_Info(vd, "OHCodec transparent OSD Surface attached (async display-size RGBA blend %ux%u)",
+             vd->cfg->display.width, vd->cfg->display.height);
+    return true;
+}
+
+static bool UploadOsd(vout_display_t *vd, subpicture_t *subpic)
+{
+    vout_display_sys_t *sys = vd->sys;
+    if (!SyncOsdWindow(vd))
+        return false;
+    if (subpic && !subpic->b_fade && sys->osd_visible &&
+        subpic->i_order == sys->osd_order)
+        return true;
+    if (!subpic && !sys->osd_visible && !sys->osd_force_upload)
+        return true;
+
+    OHNativeWindowBuffer *window_buffer = NULL;
+    OH_NativeBuffer *native_buffer = NULL;
+    int fence_fd = -1;
+    void *mapped = NULL;
+    bool requested = false;
+    bool mapped_ok = false;
+    bool success = false;
+
+    int ret = OH_NativeWindow_NativeWindowRequestBuffer(
+        sys->osd_window, &window_buffer, &fence_fd);
+    if (ret != 0 || !window_buffer)
+    {
+        msg_Warn(vd, "failed to request OSD Surface buffer: %d", ret);
+        goto done;
+    }
+    requested = true;
+    if (!WaitAndCloseFence(vd, fence_fd))
+    {
+        fence_fd = -1;
+        goto done;
+    }
+    fence_fd = -1;
+
+    ret = OH_NativeBuffer_FromNativeWindowBuffer(window_buffer, &native_buffer);
+    if (ret != 0 || !native_buffer)
+    {
+        msg_Warn(vd, "failed to access OSD NativeBuffer: %d", ret);
+        goto done;
+    }
+    ret = OH_NativeBuffer_Map(native_buffer, &mapped);
+    if (ret != 0 || !mapped)
+    {
+        msg_Warn(vd, "failed to map OSD NativeBuffer: %d", ret);
+        goto done;
+    }
+    mapped_ok = true;
+
+    BufferHandle *handle =
+        OH_NativeWindow_GetBufferHandleFromNative(window_buffer);
+    if (!handle || handle->width <= 0 || handle->height <= 0 ||
+        handle->stride < handle->width * 4 ||
+        (handle->size > 0 &&
+         (int64_t)handle->stride * handle->height > handle->size))
+    {
+        msg_Warn(vd, "invalid OSD buffer layout");
+        goto done;
+    }
+
+    const unsigned width = handle->width;
+    const unsigned height = handle->height;
+    if (width != sys->osd_width || height != sys->osd_height)
+    {
+        if (sys->osd_blend)
+            filter_DeleteBlend(sys->osd_blend);
+        video_format_t blend_fmt;
+        video_format_Init(&blend_fmt, VLC_CODEC_BGRA);
+        video_format_Setup(&blend_fmt, VLC_CODEC_BGRA,
+                           width, height, width, height, 1, 1);
+        sys->osd_blend = filter_NewBlend(VLC_OBJECT(vd), &blend_fmt);
+        video_format_Clean(&blend_fmt);
+        sys->osd_width = width;
+        sys->osd_height = height;
+        sys->osd_visible = false;
+        sys->osd_order = INT64_MIN;
+        sys->osd_force_upload = true;
+    }
+
+    if (subpic && !sys->osd_blend)
+    {
+        msg_Warn(vd, "failed to create OSD blend filter");
+        goto done;
+    }
+
+    memset(mapped, 0, (size_t)handle->stride * height);
+    if (subpic && sys->osd_blend)
+    {
+        video_format_t fmt;
+        video_format_Init(&fmt, VLC_CODEC_BGRA);
+        video_format_Setup(&fmt, VLC_CODEC_BGRA,
+                           width, height, width, height, 1, 1);
+        picture_resource_t resource = { 0 };
+        resource.p[0].p_pixels = mapped;
+        resource.p[0].i_lines = height;
+        resource.p[0].i_pitch = handle->stride;
+        picture_t *canvas = picture_NewFromResource(&fmt, &resource);
+        video_format_Clean(&fmt);
+        if (!canvas)
+            goto done;
+        picture_BlendSubpicture(canvas, sys->osd_blend, subpic);
+        picture_Release(canvas);
+    }
+
+    ret = OH_NativeBuffer_Unmap(native_buffer);
+    mapped_ok = false;
+    if (ret != 0)
+    {
+        msg_Warn(vd, "failed to unmap OSD NativeBuffer: %d", ret);
+        goto done;
+    }
+
+    struct Rect rect = { .x = 0, .y = 0, .w = width, .h = height };
+    Region region = { .rects = &rect, .rectNumber = 1 };
+    ret = OH_NativeWindow_NativeWindowFlushBuffer(
+        sys->osd_window, window_buffer, -1, region);
+    if (ret != 0)
+    {
+        msg_Warn(vd, "failed to flush OSD Surface buffer: %d", ret);
+        goto done;
+    }
+    requested = false;
+    sys->osd_visible = subpic != NULL;
+    sys->osd_order = subpic ? subpic->i_order : INT64_MIN;
+    sys->osd_force_upload = false;
+    success = true;
+
+done:
+    if (mapped_ok)
+        OH_NativeBuffer_Unmap(native_buffer);
+    if (fence_fd >= 0)
+        close(fence_fd);
+    if (requested)
+        OH_NativeWindow_NativeWindowAbortBuffer(sys->osd_window, window_buffer);
+    return success;
+}
+
+static void *OsdThread(void *opaque)
+{
+    vout_display_t *vd = opaque;
+    vout_display_sys_t *sys = vd->sys;
+
+    for (;;)
+    {
+        vlc_mutex_lock(&sys->osd_lock);
+        while (!sys->osd_pending && !sys->osd_stop)
+            vlc_cond_wait(&sys->osd_cond, &sys->osd_lock);
+
+        if (sys->osd_stop)
+        {
+            subpicture_t *pending = sys->osd_pending_subpic;
+            sys->osd_pending_subpic = NULL;
+            sys->osd_pending = false;
+            vlc_mutex_unlock(&sys->osd_lock);
+            if (pending)
+                subpicture_Delete(pending);
+            break;
+        }
+
+        subpicture_t *subpic = sys->osd_pending_subpic;
+        sys->osd_pending_subpic = NULL;
+        sys->osd_pending = false;
+        vlc_mutex_unlock(&sys->osd_lock);
+
+        const vlc_tick_t started = mdate();
+        UploadOsd(vd, subpic);
+        const vlc_tick_t elapsed = mdate() - started;
+        if (elapsed >= 50000)
+            msg_Warn(vd, "OSD upload slow: duration=%lld ms subtitle=%d",
+                     (long long)(elapsed / 1000), subpic != NULL);
+        if (subpic)
+            subpicture_Delete(subpic);
+    }
+    return NULL;
+}
+
+static void QueueOsd(vout_display_t *vd, subpicture_t *subpic)
+{
+    vout_display_sys_t *sys = vd->sys;
+    if (!sys->osd_thread_started)
+    {
+        if (subpic)
+            subpicture_Delete(subpic);
+        return;
+    }
+
+    vlc_mutex_lock(&sys->osd_lock);
+    subpicture_t *stale = sys->osd_pending_subpic;
+    sys->osd_pending_subpic = subpic;
+    sys->osd_pending = true;
+    vlc_cond_signal(&sys->osd_cond);
+    vlc_mutex_unlock(&sys->osd_lock);
+
+    /* If blending falls behind, only the newest subtitle state matters. */
+    if (stale)
+        subpicture_Delete(stale);
+}
+
+static void Prepare(vout_display_t *vd, picture_t *pic, subpicture_t *subpic)
+{
+    vout_display_sys_t *sys = vd->sys;
+
+    VLC_UNUSED(subpic);
+
+    msg_Dbg(vd, "[OHOS-DBG] Prepare: pic=%p, context=%p, need_flush=%d, date=%lld",
+            pic, pic ? pic->context : NULL, sys->need_flush,
+            pic ? (long long)pic->date : 0);
+
+    if (sys->need_flush && pic && pic->context)
+    {
+        ohos_picture_context_t *ctx = (ohos_picture_context_t *)pic->context;
+        msg_Dbg(vd, "[OHOS-DBG] Prepare: flushing surface_ctx=%p, pf_flush=%p",
+                ctx->surface_ctx, ctx->pf_flush);
+        if (ctx->pf_flush && ctx->surface_ctx)
+            ctx->pf_flush(ctx->surface_ctx);
+        sys->need_flush = false;
+    }
+}
+
+static void Display(vout_display_t *vd, picture_t *pic, subpicture_t *subpic)
+{
+    vout_display_sys_t *sys = vd->sys;
+    sys->frame_count++;
+
+    msg_Dbg(vd, "[OHOS-DBG] Display: frame#%u, pic=%p, context=%p, date=%lld, subpic=%p",
+            sys->frame_count, pic, pic ? pic->context : NULL,
+            (long long)pic->date, subpic);
+
+    /* Subtitle blending and OSD Surface fences must not hold an OHCodec
+     * video output buffer or block VLC's vout scheduler. The worker owns the
+     * subpicture after this call. */
+    QueueOsd(vd, subpic);
+    subpic = NULL;
+
+    if (pic->date == 0)
+    {
+        msg_Dbg(vd, "[OHOS-DBG] Display: date=0 frame, releasing pic=%p", pic);
+        picture_Release(pic);
+        if (subpic)
+            subpicture_Delete(subpic);
+        return;
+    }
+
+    // Prevent re-rendering the same frame (like ijkplayer behavior)
+    if (pic == sys->last_pic && pic->date == sys->last_date)
+    {
+        msg_Dbg(vd, "[OHOS-DBG] Display: skip re-render same frame pic=%p date=%lld", pic, (long long)pic->date);
+        picture_Release(pic);
+        if (subpic)
+            subpicture_Delete(subpic);
+        return;
+    }
+
+    if (pic->context)
+    {
+        ohos_picture_context_t *ctx = (ohos_picture_context_t *)pic->context;
+        msg_Dbg(vd, "[OHOS-DBG] Display: surface_ctx=%p, pf_render=%p, buf_ref=%p",
+                ctx->surface_ctx, ctx->pf_render, ctx->buf_ref);
+        if (ctx->pf_render && ctx->surface_ctx)
+        {
+            struct timespec ts;
+            clock_gettime(CLOCK_MONOTONIC, &ts);
+            int64_t now_ns = (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+            msg_Dbg(vd, "[OHOS-DBG] Display: calling pf_render(surface_ctx=%p, now_ns=%lld)",
+                    ctx->surface_ctx, (long long)now_ns);
+            const vlc_tick_t present_start = mdate();
+            int ret = ctx->pf_render(ctx->surface_ctx, now_ns);
+            const vlc_tick_t present_end = mdate();
+            if ((present_end - present_start >= 20000 ||
+                 present_start - pic->date >= 80000) &&
+                present_end - sys->last_present_warning >= CLOCK_FREQ)
+            {
+                sys->last_present_warning = present_end;
+                msg_Warn(vd, "[OHSurfaceTiming] submit=%lld ms late=%lld ms",
+                         (long long)((present_end - present_start) / 1000),
+                         (long long)((present_start - pic->date) / 1000));
+            }
+            msg_Dbg(vd, "[OHOS-DBG] Display: pf_render returned %d", ret);
+            if (ret != 0)
+            {
+                msg_Warn(vd, "[OHOS-DBG] Display: pf_render failed, skipping frame");
+                picture_Release(pic);
+                if (subpic)
+                    subpicture_Delete(subpic);
+                return;
+            }
+            if (ctx->released_ptr) {
+                __atomic_exchange_n(ctx->released_ptr, 1, __ATOMIC_SEQ_CST);
+            }
+            sys->last_pic = pic;
+            sys->last_date = pic->date;
+        }
+        else
+        {
+            msg_Warn(vd, "[OHOS-DBG] Display: cannot render! pf_render=%p, surface_ctx=%p",
+                     ctx->pf_render, ctx->surface_ctx);
+        }
+    }
+    else
+    {
+        msg_Warn(vd, "[OHOS-DBG] Display: pic->context is NULL, cannot render!");
+    }
+
+    picture_Release(pic);
+
+    if (subpic)
+        subpicture_Delete(subpic);
+}
+
+static int Control(vout_display_t *vd, int query, va_list args)
+{
+    VLC_UNUSED(vd);
+
+    switch (query)
+    {
+        case VOUT_DISPLAY_CHANGE_DISPLAY_SIZE:
+        case VOUT_DISPLAY_CHANGE_DISPLAY_FILLED:
+        case VOUT_DISPLAY_CHANGE_ZOOM:
+        case VOUT_DISPLAY_CHANGE_SOURCE_ASPECT:
+        case VOUT_DISPLAY_CHANGE_SOURCE_CROP:
+            VLC_UNUSED(args);
+            vd->sys->osd_order = INT64_MIN;
+            return VLC_SUCCESS;
+
+        case VOUT_DISPLAY_RESET_PICTURES:
+            VLC_UNUSED(args);
+            vd->sys->need_flush = true;
+            return VLC_SUCCESS;
+
+        default:
+            return VLC_EGENERIC;
+    }
+}
+
+static int Open(vlc_object_t *obj)
+{
+    vout_display_t *vd = (vout_display_t *)obj;
+    msg_Dbg(vd, "[OHOS-DBG] Open: source chroma=%4.4s, %ux%u, visible=%ux%u",
+            (char *)&vd->source.i_chroma,
+            vd->source.i_width, vd->source.i_height,
+            vd->source.i_visible_width, vd->source.i_visible_height);
+
+    if (vd->source.i_chroma != VLC_CODEC_OHOS_OPAQUE
+     && vd->source.i_chroma != VLC_CODEC_NV21) {
+        msg_Dbg(vd, "[OHOS-DBG] Open: rejected, chroma mismatch (expected OHOS_OPAQUE or NV21)");
+        return VLC_EGENERIC;
+    }
+
+    vout_display_sys_t *sys = calloc(1, sizeof(*sys));
+    if (!sys)
+        return VLC_ENOMEM;
+
+    sys->frame_count = 0;
+    sys->last_pic = NULL;
+    sys->last_date = VLC_TICK_INVALID;
+    sys->osd_order = INT64_MIN;
+    vlc_mutex_init(&sys->osd_lock);
+    vlc_cond_init(&sys->osd_cond);
+
+    vd->sys     = sys;
+    vd->fmt     = vd->source;
+    vd->pool    = Pool;
+    vd->prepare = Prepare;
+    vd->display = Display;
+    vd->control = Control;
+
+    vd->info.is_slow              = false;
+    vd->info.has_double_click     = false;
+    vd->info.needs_hide_mouse     = false;
+    vd->info.has_pictures_invalid = false;
+    vd->info.subpicture_chromas   = subpicture_chromas;
+    vd->info.scale_subpictures_to_display = true;
+    if (vlc_clone(&sys->osd_thread, OsdThread, vd,
+                  VLC_THREAD_PRIORITY_LOW) == 0)
+        sys->osd_thread_started = true;
+    else
+        msg_Warn(vd, "failed to start asynchronous OSD worker; subtitles disabled");
+    msg_Dbg(vd, "[OHOS-DBG] Open: OHOS surface display opened successfully");
+    return VLC_SUCCESS;
+}
+
+static void Close(vlc_object_t *obj)
+{
+    vout_display_t *vd = (vout_display_t *)obj;
+    vout_display_sys_t *sys = vd->sys;
+
+    msg_Dbg(vd, "[OHOS-DBG] Close: total frames displayed=%u", sys->frame_count);
+
+    if (sys->osd_thread_started)
+    {
+        vlc_mutex_lock(&sys->osd_lock);
+        sys->osd_stop = true;
+        vlc_cond_signal(&sys->osd_cond);
+        vlc_mutex_unlock(&sys->osd_lock);
+        vlc_join(sys->osd_thread, NULL);
+    }
+    if (sys->osd_visible)
+        UploadOsd(vd, NULL);
+    if (sys->osd_blend)
+        filter_DeleteBlend(sys->osd_blend);
+    vlc_cond_destroy(&sys->osd_cond);
+    vlc_mutex_destroy(&sys->osd_lock);
+
+    if (sys->pool)
+        picture_pool_Release(sys->pool);
+
+    free(sys);
+    msg_Dbg(vd, "[OHOS-DBG] Close: OHOS surface display closed");
+}
+
+vlc_module_begin()
+    set_shortname(N_("OHOS Surface"))
+    set_description(N_("OHOS hardware decoder surface output"))
+    set_category(CAT_VIDEO)
+    set_subcategory(SUBCAT_VIDEO_VOUT)
+    set_capability("vout display", 300)
+    set_callbacks(Open, Close)
+vlc_module_end()
