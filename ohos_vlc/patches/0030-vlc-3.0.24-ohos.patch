+* limitations under the License.
+*****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <vlc_common.h>
+#include <vlc_filter.h>
+#include <vlc_stream.h>
+#include <vlc_memstream.h>
+#include "../platform_fonts.h"
+
+#include "misc/webservices/json.h"
+
+#define OHOS_FONT_CONFIG_URL  "file:///system/etc/fontconfig_ohos.json"
+#define OHOS_FONT_DIR          "/system/fonts"
+
+static void OHOS_AddFamily(filter_t *p_filter, const char *family, const char *file, int weight, bool italic)
+{
+    filter_sys_t *p_sys = p_filter->p_sys;
+    vlc_dictionary_t *p_dict = &p_sys->family_map;
+
+    char *lc = ToLower(family);
+    if (!lc) {
+        return;
+    }
+
+    vlc_family_t *fam = vlc_dictionary_value_for_key(p_dict, lc);
+    if (fam == kVLCDictionaryNotFound) {
+        fam = NewFamily(p_filter, lc, &p_sys->p_families, p_dict, NULL);
+        if (!fam) {
+            goto out;
+        }
+    }
+
+    char *path;
+    if (asprintf(&path, "%s/%s", OHOS_FONT_DIR, file) < 0) {
+        goto out;
+    }
+
+    NewFont(path, 0, weight >= 700, italic, fam);
+out:
+    free(lc);
+}
+
+static void OHOS_AddFallback(filter_t *p_filter, const char *family, const char *file)
+{
+    filter_sys_t *p_sys = p_filter->p_sys;
+    vlc_dictionary_t *p_dict = &p_sys->fallback_map;
+
+    char *lc = ToLower(family);
+    if (!lc) {
+        return;
+    }
+
+    vlc_family_t *fam = vlc_dictionary_value_for_key(p_dict, lc);
+    if (fam == kVLCDictionaryNotFound) {
+        fam = NewFamily(p_filter, lc, NULL, p_dict, FB_LIST_DEFAULT);
+        if (!fam) {
+            goto out;
+        }
+    }
+
+    char *path;
+    if (asprintf(&path, "%s/%s", OHOS_FONT_DIR, file) < 0) {
+        goto out;
+    }
+
+    NewFont(path, 0, false, false, fam);
+out:
+    free(lc);
+}
+
+static int OHOS_ReadFontConfig(filter_t *p_filter, char** mem_font_config, size_t* mem_font_config_size)
+{
+    char* data = NULL;
+    size_t data_size = 0;
+
+    stream_t *font_config_stream = vlc_stream_NewURL(p_filter, OHOS_FONT_CONFIG_URL);
+    if (font_config_stream == NULL) {
+        msg_Err(p_filter, "OHOS: cannot open %s", OHOS_FONT_CONFIG_URL);
+        return VLC_EGENERIC;
+    }
+    if (vlc_stream_GetSize(font_config_stream, &data_size) != VLC_SUCCESS || data_size == 0) {
+        vlc_stream_Delete(font_config_stream);
+        msg_Err(p_filter, "OHOS: get file size error %s", OHOS_FONT_CONFIG_URL);
+        return VLC_EGENERIC;
+    }
+
+    data = malloc(data_size);
+    if (data == NULL) {
+        vlc_stream_Delete(font_config_stream);
+        msg_Err(p_filter, "OHOS: mem_font_config malloc(%d) fail", data);
+        return VLC_ENOMEM;
+    }
+
+    ssize_t curr_read_byte = 0;
+    do {
+        ssize_t read_step = vlc_stream_Read(font_config_stream,
+            data + curr_read_byte, data_size - curr_read_byte);
+
+        if (read_step < 0) {
+            vlc_stream_Delete(font_config_stream);
+            free(data);
+            return VLC_EGENERIC;
+        }
+        curr_read_byte += read_step;
+    } while (curr_read_byte < data_size);
+
+    vlc_stream_Delete(font_config_stream);
+    if (data != NULL) {
+        *mem_font_config = data;
+        *mem_font_config_size = data_size;
+    }
+    return VLC_SUCCESS;
+}
+
+static char* OHOS_SkipJsonComments(filter_t *p_filter, char* mem_font_config, size_t mem_font_config_size)
+{
+    char* mem_font_config_json = NULL;
+    bool is_note = false;
+    for(size_t i = 0; i < mem_font_config_size; i++) {
+        if (!is_note &&
+            i + 1 < mem_font_config_size &&
+            mem_font_config[i] == '/' &&
+            mem_font_config[i+1] == '*') {
+            is_note = true;
+        }
+
+        if (is_note &&
+            i + 1 < mem_font_config_size &&
+            mem_font_config[i] == '*' &&
+            mem_font_config[i+1] == '/') {
+            is_note = false;
+        }
+
+        if (!is_note && mem_font_config[i] == '{') {
+            mem_font_config_json = &mem_font_config[i];
+            break;
+        }
+    }
+    return mem_font_config_json;
+}
+
+static void OHOS_ParseFontItem(filter_t *p_filter, json_value *fonts)
+{
+     for (unsigned int i = 0; i < fonts->u.array.length; ++i) {
+        json_value *item = fonts->u.array.values[i];
+        if (item->type != json_object) {
+            continue;
+        }
+
+        int type = 0;
+        const char *alias = NULL;
+        const char *file = NULL;
+        const char *family = NULL;
+        int weight = 400;
+
+        for (unsigned int j = 0; j < item->u.object.length; ++j) {
+            const char *key = item->u.object.values[j].name;
+            json_value *value = item->u.object.values[j].value;
+
+            if (strcmp(key, "type") == 0 && value->type == json_integer) {
+                type = (int)value->u.integer;
+            } else if (strcmp(key, "alias") == 0 && value->type == json_string) {
+                alias = value->u.string.ptr;
+            } else if (strcmp(key, "file") == 0 && value->type == json_string) {
+                file = value->u.string.ptr;
+            } else if (strcmp(key, "weight") == 0 && value->type == json_integer) {
+                weight = (int)value->u.integer;
+            } else if (strcmp(key, "family") == 0 && value->type == json_string) {
+                family = value->u.string.ptr;
+            }
+        }
+
+        switch (type) {
+            case 0:
+                if (alias != NULL && file != NULL) {
+                    OHOS_AddFamily(p_filter, alias, file, weight, false);
+                }
+                break;
+            case 1:
+                if (family != NULL && file != NULL) {
+                    OHOS_AddFallback(p_filter, family, file);
+                }
+                break;
+            default: break;
+        }
+    }
+}
+
+int OHOS_Prepare(filter_t *p_filter)
+{
+    char* mem_font_config = NULL;
+    char* mem_font_config_json = NULL;
+    size_t mem_font_config_size = 0;
+
+    int ret = OHOS_ReadFontConfig(p_filter, &mem_font_config, &mem_font_config_size);
+    if (ret != NULL || mem_font_config == NULL || mem_font_config_size == NULL) {
+        return VLC_EGENERIC;
+    }
+
+    mem_font_config_json = OHOS_SkipJsonComments(p_filter, mem_font_config, mem_font_config_size);
+    if (mem_font_config_json == NULL) {
+        free(mem_font_config);
+        return VLC_EGENERIC;
+    }
+
+    json_value *root = json_parse(mem_font_config_json);
+    free(mem_font_config);
+
+    if (!root || root->type != json_object) {
+        json_value_free(root);
+        msg_Err(p_filter, "OHOS: invalid JSON");
+        return VLC_EGENERIC;
+    }
+
+    json_value *fonts = NULL;
+    for (unsigned int i = 0; i < root->u.object.length; ++i) {
+        if (strcmp(root->u.object.values[i].name, "fonts") == 0) {
+            fonts = root->u.object.values[i].value;
+            break;
+        }
+    }
+
+    if (!fonts || fonts->type != json_array) {
+        json_value_free(root);
+        msg_Err(p_filter, "OHOS: fonts array not found or invalid");
+        return VLC_EGENERIC;
+    }
+
+    OHOS_ParseFontItem(p_filter, fonts);
+
+    json_value_free(root);
+    return VLC_SUCCESS;
+}
+
+const vlc_family_t *OHOS_GetFamily(filter_t *p_filter, const char *psz_family)
+{
+    filter_sys_t *p_sys = p_filter->p_sys;
+    char *lc = ToLower(psz_family);
+    if (!lc) {
+        return NULL;
+    }
+    vlc_family_t *fam = vlc_dictionary_value_for_key(&p_sys->family_map, lc);
+    free(lc);
+    return (fam == kVLCDictionaryNotFound) ? NULL : fam;
+}
+
+vlc_family_t *OHOS_GetFallbacks(filter_t *p_filter,
+                                const char *psz_family,
+                                uni_char_t codepoint)
+{
+    VLC_UNUSED(codepoint);
+    filter_sys_t *p_sys = p_filter->p_sys;
+    char *lc = ToLower(psz_family);
+    if (!lc) {
+        return NULL;
+    }
+    vlc_family_t *fb = vlc_dictionary_value_for_key(&p_sys->fallback_map, lc);
+    free(lc);
+    return (fb == kVLCDictionaryNotFound) ? NULL : fb;
+}
