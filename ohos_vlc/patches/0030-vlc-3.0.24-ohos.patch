+/**************************************************************************
+ * set_ohos_context
+ **************************************************************************/
+void libvlc_media_player_set_ohos_nativewindow_ptr( libvlc_media_player_t *p_mi,
+                                                  void *p_owindow_handler )
+{
+    assert (p_mi != NULL);
+#ifdef __OHOS__
+    var_SetAddress (p_mi, "drawable-ohos-nativewindow-ptr", p_owindow_handler);
+#else
+    (void) p_owindow_handler;
+    libvlc_printerr ("can't set ohos window_handler ptr: OHOS build required");
+    assert(false);
+    var_SetString (p_mi, "vout", "none");
+    var_SetString (p_mi, "window", "none");
+#endif
+}
+
+void libvlc_media_player_set_ohos_osd_nativewindow_ptr( libvlc_media_player_t *p_mi,
+                                                       void *p_osd_window )
+{
+    assert (p_mi != NULL);
+#ifdef __OHOS__
+    var_SetAddress (p_mi, "drawable-ohos-osd-nativewindow-ptr", p_osd_window);
+    var_TriggerCallback (p_mi, "drawable-ohos-osd-nativewindow-ptr");
+#else
+    (void) p_osd_window;
+    libvlc_printerr ("can't set ohos OSD window ptr: OHOS build required");
+#endif
+}
