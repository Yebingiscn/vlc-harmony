+#ifdef HAVE_CONFIG_H
+# include <config.h>
+#endif
+#include <stdarg.h>
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_vout_window.h>
+#include <dlfcn.h>
+
+#include "utils.h"
+
+static int Open(vout_window_t *, const vout_window_cfg_t *);
+static void Close(vout_window_t *);
+static int Control(vout_window_t *, int, va_list ap);
+
+vlc_module_begin()
+    set_shortname(N_("OHOS Window"))
+    set_description(N_("OHOS native window"))
+    set_category(CAT_VIDEO)
+    set_subcategory(SUBCAT_VIDEO_VOUT)
+    set_capability("vout window", 10)
+    set_callbacks(Open, Close)
+vlc_module_end()
+
+
+struct vout_window_sys_t
+{
+    OHNativeWindow*     native_window;
+};
+
+static int Open(vout_window_t *wnd, const vout_window_cfg_t *cfg)
+{
+    msg_Dbg (wnd, "Opening OpenHarmony video output");
+    if (cfg->type != VOUT_WINDOW_TYPE_INVALID
+     && cfg->type != VOUT_WINDOW_TYPE_OHOS_NATIVE)
+        return VLC_EGENERIC;
+
+    vout_window_sys_t *p_sys = malloc(sizeof (*p_sys));
+    if (p_sys == NULL)
+        return VLC_ENOMEM;
+    wnd->sys = p_sys;
+    
+    uint64_t windowwidth = 0;
+    uint64_t windowheight = 0;
+    p_sys->native_window = NewOHOSWindowHandle(wnd, &windowwidth, &windowheight);    
+    if (!p_sys->native_window || windowwidth == 0 || windowheight == 0)
+        goto error;
+    
+    msg_Dbg(wnd, "vout_window_cfg_t windowwidth %d, windowheight %d: ", windowwidth, windowheight);
+    
+    wnd->type = VOUT_WINDOW_TYPE_OHOS_NATIVE;
+    wnd->handle.onativewindow = p_sys->native_window;
+    wnd->control = Control;
+    
+    vout_window_ReportSize(wnd, windowwidth, windowheight);
+    return VLC_SUCCESS;
+
+error:
+    msg_Err (wnd, "Opening OpenHarmony video output error");
+    Close(wnd);
+    return VLC_EGENERIC;
+}
+
+static void Close(vout_window_t *wnd)
+{
+    msg_Dbg(wnd, "Close enter Module Close");
+    vout_window_sys_t *p_sys = wnd->sys;
+    if (p_sys)
+    {
+        p_sys->native_window = NULL;
+        free(p_sys);
+    }
+    wnd->sys = NULL;
+}
+
+static int Control(vout_window_t *wnd, int cmd, va_list ap)
+{
+    (void) ap;
+    msg_Dbg(wnd, "[OHOS-DBG] Control: cmd=%d", cmd);
+    switch (cmd)
+    {
+        case VOUT_WINDOW_SET_STATE:
+        case VOUT_WINDOW_SET_SIZE:
+        case VOUT_WINDOW_SET_FULLSCREEN:
+            return VLC_SUCCESS;
+        default:
+            msg_Dbg(wnd, "[OHOS-DBG] Control: unhandled cmd=%d", cmd);
+            return VLC_EGENERIC;
+    }
+}
diff --git a/src/ohos/thread.c b/src/ohos/thread.c
new file mode 100644
index 0000000..fbed8b3
--- /dev/null
+++ b/src/ohos/thread.c
@@ -0,0 +1,409 @@
+/*
