+
+/* Header file of the OpenHarmony audio interface */
+#include <ohaudio/native_audiorenderer.h>
+#include <ohaudio/native_audiostream_base.h>
+#include <ohaudio/native_audiostreambuilder.h>
+#include <hilog/log.h>
+
+/* Description of the module */
+static int  Open(vlc_object_t *);
+static void Close(vlc_object_t *);
+
+#ifndef VLC_TICK_FROM_MS
+#define VLC_TICK_FROM_MS(a) (1000 * (a))
+#endif
+
+// Audio queue and timing constants
+#define AUDIO_QUEUE_THRESHOLD_SIZE   16384    /* Queue size threshold in bytes */
+#define AUDIO_RING_CAPACITY          (16u * 1024u * 1024u)
+#define AUDIO_MAX_QUEUE_MS           250
+#define AUDIO_QUEUE_WAIT_MS          100
+#define RENDERER_STALL_TIMEOUT       2000000  /* Stall timeout in microseconds (2s) */
+
+vlc_module_begin()
+    set_shortname("OHOS:Audio")
+    set_description("OpenHarmony Audio Renderer")
+    set_category(CAT_AUDIO)
+    set_subcategory(SUBCAT_AUDIO_AOUT)
+    set_capability("audio output", 101) //101 Setting the priority
+    set_callbacks(Open, Close)
+vlc_module_end()
+
+// Audio data queue structure
+typedef struct {
+    uint8_t *data;
+    size_t capacity;
+    size_t read_pos;
+    size_t write_pos;
+    vlc_mutex_t lock;
+    vlc_cond_t writable;
+    size_t total_size;
+    size_t bytes_per_second;
+    vlc_tick_t submitted_until;
+} audio_queue_t;
+
+// delay statistics structure
+typedef struct {
+    // basic statistics
+    vlc_tick_t min_delay;
+    vlc_tick_t max_delay;
+    vlc_tick_t avg_delay;
+    vlc_tick_t current_delay;
+
+    // Time trace
+    vlc_tick_t last_update;
+    vlc_tick_t stats_start_time;
+
+    // counter
+    uint64_t call_count;
+
+    // Performance indicators
+    vlc_tick_t total_delay_accumulated;
+} audio_delay_stats_t;
+
+// OpenHarmony audio output module private data structure
+struct aout_sys_t {
+    // OpenHarmony Audio Renderer handle
+    OH_AudioRenderer *p_renderer;
+    OH_AudioStreamBuilder *builder;
+    // audio data queue
+    audio_queue_t queue;
+
+    // Audio format information
+    uint32_t buffer_duration;
+
+    // Audio status control
+    bool is_playing;
+    bool is_initialized;
+    float volume;
+    bool mute;
+
+    // Audio format parameters
+    unsigned int sample_rate;
+    unsigned int channels;
+    OH_AudioStream_Result last_error;
+    OH_AudioStream_SampleFormat sample_format;
+    // estimated hardware latency
+    vlc_tick_t estimated_hardware_latency;
+    audio_delay_stats_t delay_stats;
+    bool draining;                    // Is emptying
+    vlc_tick_t drain_start_time;      // Start time of emptying
+    size_t drain_initial_size;        // The queue size at the start of emptying
+    vlc_cond_t drain_cond;           // emptying condition variables
+    vlc_tick_t last_write_time;
+    size_t max_queue_size;
+    bool flushed_since_play;
+};
+
+// Initiating the queue operation
+static int audio_queue_init(audio_queue_t *queue)
+{
+    queue->data = malloc(AUDIO_RING_CAPACITY);
+    if (!queue->data)
+        return VLC_ENOMEM;
+    queue->capacity = AUDIO_RING_CAPACITY;
+    queue->read_pos = 0;
+    queue->write_pos = 0;
+    queue->total_size = 0;
+    vlc_mutex_init(&queue->lock);
+    vlc_cond_init(&queue->writable);
+    return VLC_SUCCESS;
+}
+
+static void audio_queue_clear(audio_queue_t *queue)
+{
+    vlc_mutex_lock(&queue->lock);
+    queue->read_pos = 0;
+    queue->write_pos = 0;
+    queue->total_size = 0;
+    vlc_cond_broadcast(&queue->writable);
+    queue->submitted_until = 0;
+    vlc_mutex_unlock(&queue->lock);
+}
+
+static void audio_queue_destroy(audio_queue_t *queue)
+{
+    free(queue->data);
+    queue->data = NULL;
+    queue->capacity = 0;
+    vlc_cond_destroy(&queue->writable);
+    vlc_mutex_destroy(&queue->lock);
+}
+
+static bool audio_queue_push(audio_queue_t *queue, const uint8_t *data,
+                             size_t size, size_t max_queue_size)
+{
+    /* Pace against a soft target. Never discard valid PCM just because a
+     * callback-sized block or synchronization silence crosses that target. */
+    if (size > queue->capacity)
+        return false;
+    vlc_mutex_lock(&queue->lock);
+
+    const vlc_tick_t deadline = mdate() + VLC_TICK_FROM_MS(AUDIO_QUEUE_WAIT_MS);
+    while (queue->total_size >= max_queue_size ||
+           size > queue->capacity - queue->total_size) {
+        if (vlc_cond_timedwait(&queue->writable, &queue->lock, deadline) != 0)
+            break;
+    }
+
+    if (size > queue->capacity - queue->total_size) {
+        vlc_mutex_unlock(&queue->lock);
+        return false;
+    }
+
+    size_t first = __MIN(size, queue->capacity - queue->write_pos);
+    memcpy(queue->data + queue->write_pos, data, first);
+    memcpy(queue->data, data + first, size - first);
+    queue->write_pos = (queue->write_pos + size) % queue->capacity;
+    queue->total_size += size;
+    vlc_mutex_unlock(&queue->lock);
+    return true;
+}
+
+static size_t audio_queue_drain(audio_queue_t *queue, uint8_t *output, size_t requested_size, bool *has_more)
+{
+    size_t copied = 0;
+
+    vlc_mutex_lock(&queue->lock);
+
+    copied = __MIN(requested_size, queue->total_size);
+    size_t first = __MIN(copied, queue->capacity - queue->read_pos);
+    if (output) {
+        memcpy(output, queue->data + queue->read_pos, first);
+        memcpy(output + first, queue->data, copied - first);
+    }
+    queue->read_pos = (queue->read_pos + copied) % queue->capacity;
+    queue->total_size -= copied;
+    if (copied > 0 && queue->bytes_per_second > 0)
+        queue->submitted_until = mdate() +
+            (vlc_tick_t)copied * CLOCK_FREQ / queue->bytes_per_second;
+    if (copied > 0)
+        vlc_cond_signal(&queue->writable);
+
+    // Set the flag of whether there is more data
+    if (has_more) {
+        *has_more = queue->total_size != 0;
+    }
+
+    vlc_mutex_unlock(&queue->lock);
+
+    return copied;
+}
+
+static size_t audio_queue_size(audio_queue_t *queue)
+{
+    size_t size;
+    vlc_mutex_lock(&queue->lock);
+    size = queue->total_size;
+    vlc_mutex_unlock(&queue->lock);
+    return size;
+}
+
+// OpenHarmony audio callback function
+static int32_t OnWriteData(OH_AudioRenderer *renderer, void *userData,
+                          void *buffer, int32_t length)
+{
+    audio_output_t *p_aout = (audio_output_t *)userData;
+    aout_sys_t *p_sys = p_aout->sys;
+
+    if (!p_sys || !buffer || length <= 0)
+        return 0;
+
+    p_sys->last_write_time = mdate();
+
+    bool has_more_data = false;
+    size_t copied = 0;
+
+    copied = audio_queue_drain(&p_sys->queue, (uint8_t*)buffer, length,
+                               &has_more_data);
+
+    VLC_UNUSED(has_more_data);
+
+    return copied;
+}
+
+static int VolumeSet(audio_output_t *p_aout, float f_volume)
+{
+    aout_sys_t *p_sys = p_aout->sys;
+
+    if (!p_sys->p_renderer) {
+        return VLC_EGENERIC;
+    }
+
+    // Convert to 0-1.0 range (the range expected by OpenHarmony)
+    float volume = f_volume;
+    if (volume < 0.0f) volume = 0.0f;
+    if (volume > 1.0f) volume = 1.0f;
+
+    OH_AudioStream_Result result = OH_AudioRenderer_SetVolume(p_sys->p_renderer, volume);
+    if (result == AUDIOSTREAM_SUCCESS) {
+        p_sys->volume = volume;
+        msg_Dbg(p_aout, "Volume set to: %.2f", volume);
+        aout_VolumeReport(p_aout, p_sys->volume);
+        return VLC_SUCCESS;
+    } else {
+        msg_Err(p_aout, "Failed to set volume: %d", result);
+        return VLC_EGENERIC;
+    }
+}
+
+static size_t get_bytes_per_sample(audio_output_t *p_aout,
+                                   OH_AudioStream_SampleFormat format);
+
+static int MuteSet(audio_output_t *p_aout, bool mute)
+{
+    aout_sys_t *p_sys = p_aout->sys;
+    p_sys->mute = mute;
+
+    if (p_sys->p_renderer != NULL) {
+        OH_AudioStream_Result result = OH_AudioRenderer_SetVolume(
+            p_sys->p_renderer, mute ? 0.0f : p_sys->volume);
+        if (result != AUDIOSTREAM_SUCCESS)
+            return VLC_EGENERIC;
+    }
+    aout_MuteReport(p_aout, mute);
+    return VLC_SUCCESS;
+}
+
+static int RestartRenderer(audio_output_t *p_aout)
+{
+    aout_sys_t *p_sys = p_aout->sys;
+
+    msg_Info(p_aout, "Restarting audio renderer after background recovery");
+
+    if (p_sys->p_renderer) {
+        OH_AudioRenderer_Stop(p_sys->p_renderer);
+        OH_AudioRenderer_Release(p_sys->p_renderer);
+        p_sys->p_renderer = NULL;
+    }
+    if (p_sys->builder) {
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+    }
+
+    OH_AudioStream_Result result = OH_AudioStreamBuilder_Create(&p_sys->builder, AUDIOSTREAM_TYPE_RENDERER);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Restart: failed to create builder: %d", result);
+        return VLC_EGENERIC;
+    }
+
+    OH_AudioStreamBuilder_SetSamplingRate(p_sys->builder, p_sys->sample_rate);
+    OH_AudioStreamBuilder_SetChannelCount(p_sys->builder, p_sys->channels);
+    OH_AudioStreamBuilder_SetSampleFormat(p_sys->builder, p_sys->sample_format);
+    OH_AudioStreamBuilder_SetRendererInfo(p_sys->builder, AUDIOSTREAM_USAGE_MOVIE);
+
+    result = OH_AudioStreamBuilder_SetRendererWriteDataCallbackAdvanced(
+        p_sys->builder, OnWriteData, p_aout);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Restart: failed to set advanced write callback: %d",
+                result);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    result = OH_AudioStreamBuilder_GenerateRenderer(p_sys->builder, &p_sys->p_renderer);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Restart: failed to generate renderer: %d", result);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    result = OH_AudioRenderer_Start(p_sys->p_renderer);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Restart: failed to start renderer: %d", result);
+        OH_AudioRenderer_Release(p_sys->p_renderer);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->p_renderer = NULL;
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    p_sys->is_playing = true;
+    p_sys->is_initialized = true;
+    p_sys->last_write_time = 0;
+    p_sys->flushed_since_play = false;
+    p_aout->volume_set(p_aout, p_sys->volume);
+    if (p_sys->mute)
+        p_aout->mute_set(p_aout, true);
+
+    msg_Info(p_aout, "Audio renderer restarted: %d ch, %d Hz", p_sys->channels, p_sys->sample_rate);
+    return VLC_SUCCESS;
+}
+
+static int Start(audio_output_t *p_aout, audio_sample_format_t *p_fmt)
+{
+    msg_Info(p_aout, "Starting OpenHarmony audio output");
+    aout_sys_t *p_sys = p_aout->sys;
+
+    // Clearing the resources
+    if (p_sys->p_renderer) {
+        OH_AudioRenderer_Stop(p_sys->p_renderer);
+        OH_AudioRenderer_Release(p_sys->p_renderer);
+        p_sys->p_renderer = NULL;
+    }
+
+    if (p_sys->builder) {
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+    }
+
+    // To create an audio stream builder
+    OH_AudioStream_Result result = OH_AudioStreamBuilder_Create(&p_sys->builder, AUDIOSTREAM_TYPE_RENDERER);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Failed to create audio stream builder: %d", result);
+        return VLC_EGENERIC;
+    }
+
+    // Setting audio parameters
+    p_sys->sample_rate = p_fmt->i_rate;
+    p_sys->channels = aout_FormatNbChannels(p_fmt);
+    if (p_sys->sample_rate == 0 || p_sys->channels == 0) {
+        msg_Warn(p_aout, "Rejecting invalid audio format: %u channels, %u Hz",
+                 p_sys->channels, p_sys->sample_rate);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    switch (p_fmt->i_format) {
+        case VLC_CODEC_S16N:
+            p_sys->sample_format = AUDIOSTREAM_SAMPLE_S16LE;
+            break;
+        case VLC_CODEC_S32N:
+            p_sys->sample_format = AUDIOSTREAM_SAMPLE_S32LE;
+            break;
+        case VLC_CODEC_FL32:
+            p_sys->sample_format = AUDIOSTREAM_SAMPLE_F32LE;
+            break;
+        default:
+            p_sys->sample_format = AUDIOSTREAM_SAMPLE_S16LE;
+            p_fmt->i_format = VLC_CODEC_S16N;
+            msg_Warn(p_aout, "Starting Unsupported format format %d", (int)p_sys->sample_format);
+            break;
+    }
+
+    OH_AudioStreamBuilder_SetSamplingRate(p_sys->builder, p_sys->sample_rate);
+    OH_AudioStreamBuilder_SetChannelCount(p_sys->builder, p_sys->channels);
+    OH_AudioStreamBuilder_SetSampleFormat(p_sys->builder, p_sys->sample_format);
+    OH_AudioStreamBuilder_SetRendererInfo(p_sys->builder, AUDIOSTREAM_USAGE_MOVIE);
+
+    result = OH_AudioStreamBuilder_SetRendererWriteDataCallbackAdvanced(
+        p_sys->builder, OnWriteData, p_aout);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Failed to set advanced write callback: %d", result);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    // Generate Renderer
+    result = OH_AudioStreamBuilder_GenerateRenderer(p_sys->builder, &p_sys->p_renderer);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Failed to generate audio renderer: %d", result);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    // Start the Renderer
+    result = OH_AudioRenderer_Start(p_sys->p_renderer);
+    if (result != AUDIOSTREAM_SUCCESS) {
+        msg_Err(p_aout, "Failed to start audio renderer: %d", result);
+        OH_AudioRenderer_Release(p_sys->p_renderer);
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->p_renderer = NULL;
+        p_sys->builder = NULL;
+        return VLC_EGENERIC;
+    }
+
+    p_sys->is_playing = true;
+    p_sys->is_initialized = true;
+    p_sys->last_write_time = 0;
+    p_sys->flushed_since_play = false;
+    const size_t bytes_per_sample = get_bytes_per_sample(p_aout,
+                                                          p_sys->sample_format);
+    const uint64_t queue_bytes = (uint64_t)p_sys->sample_rate *
+                                 p_sys->channels * bytes_per_sample *
+                                 AUDIO_MAX_QUEUE_MS / 1000;
+    p_sys->max_queue_size = __MIN((size_t)queue_bytes,
+                                  p_sys->queue.capacity);
+    vlc_mutex_lock(&p_sys->queue.lock);
+    p_sys->queue.bytes_per_second = (size_t)p_sys->sample_rate *
+                                   p_sys->channels * bytes_per_sample;
+    p_sys->queue.submitted_until = 0;
+    vlc_mutex_unlock(&p_sys->queue.lock);
+
+    p_aout->volume_set(p_aout, p_sys->volume);
+    if (p_sys->mute)
+        p_aout->mute_set(p_aout, true);
+
+    msg_Info(p_aout, "OpenHarmony audio output started: %d channels, %d Hz", 
+             p_sys->channels, p_sys->sample_rate);
+    msg_Info(p_aout, "Audio low-latency queue configured: %zu bytes (%d ms)",
+             p_sys->max_queue_size, AUDIO_MAX_QUEUE_MS);
+
+    return VLC_SUCCESS;
+}
+
+// Gets the number of bytes per sample based on the sampling format
+static size_t get_bytes_per_sample(audio_output_t *p_aout, OH_AudioStream_SampleFormat format)
+{
+    switch (format) {
+        case AUDIOSTREAM_SAMPLE_U8:
+            return 1;
+        case AUDIOSTREAM_SAMPLE_S16LE:
+            return 2;
+        case AUDIOSTREAM_SAMPLE_S24LE:
+            return 3;
+        case AUDIOSTREAM_SAMPLE_S32LE:
+        case AUDIOSTREAM_SAMPLE_F32LE:
+            return 4;
+        default:
+            msg_Warn(p_aout, "get_bytes_per_sample default format %d", (int)AUDIOSTREAM_SAMPLE_S24LE);
+            return 2;
+    }
+}
+
+// Convert vlc_tick_t to milliseconds (for log output)
+inline int64_t vlc_tick_to_ms(vlc_tick_t ticks)
+{
+    return ticks / 1000;
+}
+
+static vlc_tick_t vlc_tick_from_samples(uint64_t samples, uint32_t sample_rate)
+{
+    if (sample_rate == 0) {
+        return 0;
+    }
+
+    // Calculation formula: Time = (Number of samples x Clock_FREQ) /Sampling rate
+    // Usually, the clock_FREQ is 1000000 (1MHz), which means there are 1 million ticks per second
+    return (vlc_tick_t)((samples * 1000000LL) / sample_rate);
+}
+
+static void Stop(audio_output_t *p_aout)
+{
+    msg_Info(p_aout, "Stopping OpenHarmony audio output");
+    aout_sys_t *p_sys = p_aout->sys;
+
+    if (!p_sys) {
+        return;
+    }
+
+    p_sys->is_playing = false;
+    audio_queue_clear(&p_sys->queue);
+
+    if (p_sys->p_renderer) {
+        OH_AudioRenderer_Stop(p_sys->p_renderer);
+        OH_AudioRenderer_Release(p_sys->p_renderer);
+        p_sys->p_renderer = NULL;
+    }
+
+    if (p_sys->builder) {
+        OH_AudioStreamBuilder_Destroy(p_sys->builder);
+        p_sys->builder = NULL;
+    }
+
+    p_sys->is_initialized = false;
+
+    msg_Info(p_aout, "Audio output stopped completely");
+}
+
+static void Play(audio_output_t *p_aout, block_t *p_block)
+{
+    aout_sys_t *p_sys = p_aout->sys;
+
+    if (!p_sys->is_initialized || !p_sys->p_renderer) {
+        if (RestartRenderer(p_aout) != VLC_SUCCESS) {
+            if (p_block) {
+                block_Release(p_block);
+            }
+            return;
+        }
+    } else if (p_sys->last_write_time > 0 && audio_queue_size(&p_sys->queue) > AUDIO_QUEUE_THRESHOLD_SIZE) {
+        vlc_tick_t elapsed = mdate() - p_sys->last_write_time;
+        if (elapsed > RENDERER_STALL_TIMEOUT) {
+            if (RestartRenderer(p_aout) != VLC_SUCCESS) {
+                if (p_block) {
+                    block_Release(p_block);
+                }
+                return;
+            }
+        }
+    }
+
+    if (p_block && p_block->i_buffer > 0) {
+        p_sys->flushed_since_play = false;
+        if (!audio_queue_push(&p_sys->queue, p_block->p_buffer,
+                              p_block->i_buffer, p_sys->max_queue_size)) {
+            static vlc_tick_t last_overflow_log;
+            const vlc_tick_t now = mdate();
+            if (now - last_overflow_log > VLC_TICK_FROM_MS(1000)) {
+                msg_Warn(p_aout,
+                         "Audio low-latency queue timed out, dropping %zu bytes",
+                         p_block->i_buffer);
+                last_overflow_log = now;
+            }
+        }
+    }
+
+    if (p_block) {
+        block_Release(p_block);
+    }
+}
+
+static void Pause(audio_output_t *p_aout, bool b_paused, vlc_tick_t i_date)
+{
+    VLC_UNUSED(i_date);
+    aout_sys_t *p_sys = p_aout->sys;
+
+    if (!p_sys->p_renderer) {
+        return;
+    }
+
+    if (b_paused && p_sys->is_playing) {
+        OH_AudioRenderer_Pause(p_sys->p_renderer);
+        p_sys->is_playing = false;
+        p_sys->last_write_time = 0;
+        msg_Dbg(p_aout, "Audio paused");
+    } else if (!b_paused && !p_sys->is_playing) {
+        OH_AudioRenderer_Start(p_sys->p_renderer);
+        p_sys->is_playing = true;
+        msg_Dbg(p_aout, "Audio resumed");
+    }
+}
+
+static void Flush(audio_output_t *p_aout, bool wait)
+{
+    VLC_UNUSED(wait);
+    aout_sys_t *p_sys = p_aout->sys;
+
+    msg_Dbg(p_aout, "Flushing audio queue");
+    audio_queue_clear(&p_sys->queue);
+
+    /* VLC can request repeated flushes while discarding stale timestamps.
+     * With no intervening Play there is no new audio to flush. */
+    if (p_sys->p_renderer && !p_sys->flushed_since_play) {
+        if (OH_AudioRenderer_Flush(p_sys->p_renderer) == AUDIOSTREAM_SUCCESS)
+            p_sys->flushed_since_play = true;
+    }
+}
+
+// Calculate detailed queue delay
+static vlc_tick_t calculate_detailed_queue_delay(audio_output_t *p_aout, aout_sys_t *p_sys)
+{
+    // Check basic parameters
+    if (p_sys->sample_rate == 0 || p_sys->channels == 0) {
+        return 0;
+    }
+    // Gets the number of bytes per sample
+    size_t bytes_per_sample = get_bytes_per_sample(p_aout, p_sys->sample_format);
+
+    size_t effective_bytes = audio_queue_size(&p_sys->queue);
+    // Calculate the number of samples
+    size_t total_samples = effective_bytes / bytes_per_sample;
+    size_t samples_per_channel = total_samples / p_sys->channels;
+    // Convert to time (using vlc_tick_from_samples)
+    return vlc_tick_from_samples(samples_per_channel, p_sys->sample_rate);
+}
+
+static void update_delay_statistics(aout_sys_t *p_sys, vlc_tick_t current_delay)
+{
+    if (p_sys->delay_stats.min_delay == 0 && p_sys->delay_stats.max_delay == 0) {
+        p_sys->delay_stats.min_delay = INT64_MAX;
+        p_sys->delay_stats.stats_start_time = mdate();
+    }
+
+    if (current_delay < p_sys->delay_stats.min_delay) {
+        p_sys->delay_stats.min_delay = current_delay;
+    }
+    if (current_delay > p_sys->delay_stats.max_delay) {
+        p_sys->delay_stats.max_delay = current_delay;
+    }
+
+    if (p_sys->delay_stats.avg_delay == 0) {
+        p_sys->delay_stats.avg_delay = current_delay;
+    } else {
+        p_sys->delay_stats.avg_delay =
+            (p_sys->delay_stats.avg_delay * 9 + current_delay) / 10;
+    }
+
+    p_sys->delay_stats.current_delay = current_delay;
+    p_sys->delay_stats.call_count++;
+    p_sys->delay_stats.last_update = mdate();
+
+    p_sys->delay_stats.total_delay_accumulated += current_delay;
+}
+
+static void log_delay_debug_info(audio_output_t *p_aout, vlc_tick_t queue_delay, 
+                                vlc_tick_t hardware_delay, vlc_tick_t total_delay)
+{
+    static vlc_tick_t last_log_time = 0;
+    vlc_tick_t now = mdate();
+
+    // The debugging information is output every 5 seconds to avoid excessive log files
+    if (now - last_log_time > VLC_TICK_FROM_MS(5000)) {
+        aout_sys_t *p_sys = p_aout->sys;
+
+        msg_Dbg(p_aout,
+               "Audio Delay - Queue: %" PRId64 "ms, Hardware: %" PRId64 "ms, Total: %" PRId64 "ms, "
+               "Queue Size: %zu bytes",
+               vlc_tick_to_ms(queue_delay),
+               vlc_tick_to_ms(hardware_delay),
+               vlc_tick_to_ms(total_delay),
+               audio_queue_size(&p_sys->queue));
+
+        // The detailed statistics are output every 30 seconds
+        static vlc_tick_t last_detailed_log = 0;
+        if (now - last_detailed_log > VLC_TICK_FROM_MS(30000)) {
+            if (p_sys->delay_stats.call_count > 0) {
+                vlc_tick_t global_avg = p_sys->delay_stats.total_delay_accumulated / 
+                                      p_sys->delay_stats.call_count;
+
+                msg_Dbg(p_aout,
+                       "Delay Stats - Min: %" PRId64 "ms, Max: %" PRId64 "ms, Avg: %" PRId64 "ms, "
+                       "Calls: %zu",
+                       vlc_tick_to_ms(p_sys->delay_stats.min_delay),
+                       vlc_tick_to_ms(p_sys->delay_stats.max_delay),
+                       vlc_tick_to_ms(global_avg),
+                       p_sys->delay_stats.call_count);
+
+                last_detailed_log = now;
+            }
+        }
+
+        last_log_time = now;
+    }
+}
+
+static int TimeGet(audio_output_t *p_aout, vlc_tick_t *delay)
+{
+    aout_sys_t *p_sys = p_aout->sys;
+
+    // parameter verification
+    if (unlikely(!p_sys || !delay)) {
+        if (delay) {
+            *delay = 0;
+        }
+        return VLC_EGENERIC;
+    }
+    // Check the audio output status
+    if (!p_sys->is_initialized || !p_sys->p_renderer || !p_sys->is_playing) {
+        *delay = 0;
+        return VLC_SUCCESS;
+    }
+
+    // Calculate each delay component
+    vlc_tick_t hardware_delay = p_sys->estimated_hardware_latency;
+    vlc_mutex_lock(&p_sys->queue.lock);
+    /* Sample queued and submitted bytes atomically: the callback transfers
+     * bytes between these two states under the same lock. */
+    vlc_tick_t queue_delay = p_sys->queue.bytes_per_second > 0
+        ? (vlc_tick_t)p_sys->queue.total_size * CLOCK_FREQ /
+          p_sys->queue.bytes_per_second : 0;
+    hardware_delay += __MAX(p_sys->queue.submitted_until - mdate(), 0);
+    vlc_mutex_unlock(&p_sys->queue.lock);
+
+    // total delay
+    vlc_tick_t total_delay = queue_delay + hardware_delay;
+
+    if (total_delay < 0) {
+        total_delay = 0;
+    }
+
+    update_delay_statistics(p_sys, total_delay);
+
+    *delay = total_delay;
+
+    // Regularly output debugging information
+    log_delay_debug_info(p_aout, queue_delay, hardware_delay, total_delay);
+    return VLC_SUCCESS;
+}
+
+static int Open(vlc_object_t *obj)
+{
+    msg_Info(obj, "Opening OpenHarmony audio output");
+    audio_output_t *p_aout = (audio_output_t *)obj;
+    aout_sys_t *p_sys;
+
+    p_sys = calloc(1, sizeof(aout_sys_t));
+    if (!p_sys) {
+        return VLC_ENOMEM;
+    }
+
+    // Initiating the system structure
+    p_sys->p_renderer = NULL;
+    p_sys->builder = NULL;
+    p_sys->is_playing = false;
+    p_sys->is_initialized = false;
+    p_sys->sample_rate = 44100;
+    p_sys->channels = 2;
+    p_sys->last_error = AUDIOSTREAM_SUCCESS;
+
+    p_sys->draining = false;
+    p_sys->drain_start_time = 0;
+    p_sys->drain_initial_size = 0;
+    vlc_cond_init(&p_sys->drain_cond);
+
+    // Initiating hardware delay estimate
+    p_sys->estimated_hardware_latency = VLC_TICK_FROM_MS(30); // 30ms initial estimate
+
+    // Initiating delay statistics
+    memset(&p_sys->delay_stats, 0, sizeof(p_sys->delay_stats));
+    p_sys->delay_stats.min_delay = INT64_MAX;
+    p_sys->delay_stats.stats_start_time = mdate();
+
+    // Initiating the audio queue
+    if (audio_queue_init(&p_sys->queue) != VLC_SUCCESS) {
+        vlc_cond_destroy(&p_sys->drain_cond);
+        free(p_sys);
+        return VLC_ENOMEM;
+    }
+
+    p_aout->sys = p_sys;
+    p_aout->start = Start;
+    p_aout->stop = Stop;
+    p_aout->time_get = TimeGet;
+    p_aout->play = Play;
+    p_aout->pause = Pause;
+    p_aout->flush = Flush;
+    p_aout->volume_set = VolumeSet;
+    p_aout->mute_set = MuteSet;
+    p_sys->volume = 1.0f;
+    p_sys->mute = false;
+
+    msg_Info(obj, "OpenHarmony audio output opened successfully");
+    return VLC_SUCCESS;
+}
+
+static void Close(vlc_object_t *obj)
+{
+    msg_Info(obj, "Closing OpenHarmony audio output - ensuring complete playback");
+    audio_output_t *p_aout = (audio_output_t *)obj;
+    aout_sys_t *p_sys = p_aout->sys;
+    
+    if (!p_sys) {
+        return;
+    }
+    
+    // Diagnostics: Checks the data remaining in the queue when it is closed
+    size_t initial_bytes_size = audio_queue_size(&p_sys->queue);
+    if (initial_bytes_size > 0) {
+        msg_Err(obj, "Closing with %zu bytes remaining in audio queue - ensuring complete playback", 
+                initial_bytes_size);
+    }
+    
+    Stop(p_aout);
+    
+    audio_queue_destroy(&p_sys->queue);
+    vlc_cond_destroy(&p_sys->drain_cond);
+
+    free(p_sys);
+    msg_Info(obj, "OpenHarmony audio output closed");
+}
