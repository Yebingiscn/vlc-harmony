+#ifndef VLC_OHOS_DISPLAY_H
+#define VLC_OHOS_DISPLAY_H
+
+#include <vlc_picture.h>
+
+typedef struct {
+    picture_context_t s;
+    void *surface_ctx;
+    void *buf_ref;
+    int (*pf_render)(void *surface_ctx, int64_t timestamp_ns);
+    int (*pf_flush)(void *surface_ctx);
+    volatile int32_t *released_ptr;
+} ohos_picture_context_t;
+
+#endif /* VLC_OHOS_DISPLAY_H */
