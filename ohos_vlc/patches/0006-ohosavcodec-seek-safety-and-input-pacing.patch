From: vlc-harmony maintainers
Subject: [PATCH] ohosavcodec: make seek flush and large access units safe

Serialize decoder generations across Flush, clear callback queues, reject stale
surface output, avoid 0ms busy polling, and split compressed access units with
AVCODEC_BUFFER_FLAGS_INCOMPLETE_FRAME when they exceed an OHCodec input slot.
diff --git a/libavcodec/ohosavcodecdec.c b/libavcodec/ohosavcodecdec.c
index 78ef311..cfcab9f 100644
--- a/libavcodec/ohosavcodecdec.c
+++ b/libavcodec/ohosavcodecdec.c
@@ -118,7 +118,7 @@ static int ohosavcodec_receive_frame(struct AVCodecContext *avctx, struct AVFram
     s->ctx->isSend = false;
     while(1) {
         if (s->buffered_pkt.size > 0) {
-            ret = ff_ohosavcodec_dec_send(avctx, s->ctx, &s->buffered_pkt, false);
+            ret = ff_ohosavcodec_dec_send(avctx, s->ctx, &s->buffered_pkt, true);
             if (ret >= 0) {
                 s->buffered_pkt.size -= ret;
                 s->buffered_pkt.data += ret;
@@ -133,6 +133,12 @@ static int ohosavcodec_receive_frame(struct AVCodecContext *avctx, struct AVFram
                 return AVERROR_EXTERNAL;
             }
             if (s->buffered_pkt.size > 0) {
+                /* 大访问单元会拆成多个 OHCodec 输入槽。每段均标记
+                 * INCOMPLETE_FRAME，同时穿插取输出，避免输入/输出池互相等待。 */
+                ret = ff_ohosavcodec_dec_receive(avctx, s->ctx, frame, false);
+                if (ret != AVERROR(EAGAIN)) {
+                    return ret;
+                }
                 continue;
             }
         }
