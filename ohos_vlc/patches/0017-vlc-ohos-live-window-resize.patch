+VLC_API void vout_ReportDisplayWindowSize(vout_thread_t *vout,
+                                          unsigned width, unsigned height)
+{
+    if (width == 0 || height == 0)
+        return;
+
+    vout_window_t *window = vout->p->window;
+    if (window != NULL)
+        vout_window_ReportSize(window, width, height);
+    else if (vout->p->display.vd != NULL)
+        vout_display_SendEventDisplaySize(vout->p->display.vd, width, height);
+}
