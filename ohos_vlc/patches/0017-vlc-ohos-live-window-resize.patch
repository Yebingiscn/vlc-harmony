+void libvlc_video_set_ohos_window_size( libvlc_media_player_t *p_mi,
+                                        unsigned width, unsigned height )
+{
+    if (width == 0 || height == 0)
+        return;
+
+    vout_thread_t *vout = GetVout(p_mi, 0);
+    if (vout == NULL)
+        return;
+
+    vout_SetDisplayWindowSize(vout, width, height);
+    vlc_object_release(vout);
+}
