diff --git a/modules/codec/avcodec/audio.c b/modules/codec/avcodec/audio.c
index d3748cc..9be3c6f 100644
--- a/modules/codec/avcodec/audio.c
+++ b/modules/codec/avcodec/audio.c
@@ -39,6 +39,7 @@
 #include "avcodec.h"
 
 #include <libavcodec/avcodec.h>
+#include <libavutil/error.h>
 #include <libavutil/mem.h>
 
 #define API_CHANNEL_LAYOUT_STRUCT (LIBAVCODEC_VERSION_CHECK(59, 24, 100)) // AVCodecContext.ch_layout
@@ -144,8 +145,17 @@ static int OpenAudioCodec( decoder_t *p_dec )
     }
 
     ctx->sample_rate = p_dec->fmt_in.audio.i_rate;
+    /* Opus always decodes at 48 kHz. Some MP4/WebM demux paths leave the
+     * input audio rate and channel count unset and expect libavcodec to read
+     * them from OpusHead. Do not replace that information with an invalid
+     * zero-channel layout before avcodec_open2(). */
+    if( codec->id == AV_CODEC_ID_OPUS && ctx->sample_rate <= 0 )
+        ctx->sample_rate = 48000;
 #if API_CHANNEL_LAYOUT_STRUCT && LIBAVUTIL_VERSION_CHECK(57, 24, 100)
-    av_channel_layout_default( &ctx->ch_layout, p_dec->fmt_in.audio.i_channels );
+    if( p_dec->fmt_in.audio.i_channels > 0 )
+        av_channel_layout_default( &ctx->ch_layout,
+                                   p_dec->fmt_in.audio.i_channels );
 #else
-    ctx->channels = p_dec->fmt_in.audio.i_channels;
+    if( p_dec->fmt_in.audio.i_channels > 0 )
+        ctx->channels = p_dec->fmt_in.audio.i_channels;
 #endif
     ctx->block_align = p_dec->fmt_in.audio.i_blockalign;
     ctx->bit_rate = p_dec->fmt_in.i_bitrate;
diff --git a/modules/codec/avcodec/avcodec.c b/modules/codec/avcodec/avcodec.c
index c0f6c2c..a3ada33 100644
--- a/modules/codec/avcodec/avcodec.c
+++ b/modules/codec/avcodec/avcodec.c
@@ -36,5 +36,6 @@
 #define HAVE_MMX 1
 #include <libavcodec/avcodec.h>
+#include <libavutil/error.h>
 
 #include "avcodec.h"
 #include "chroma.h"
@@ -361,6 +362,10 @@ int ffmpeg_OpenCodec( decoder_t *p_dec, AVCodecContext *ctx,
 
     if( ret < 0 )
     {
-        msg_Err( p_dec, "cannot start codec (%s)", codec->name );
+        char error_string[AV_ERROR_MAX_STRING_SIZE];
+        if( av_strerror( ret, error_string, sizeof(error_string) ) < 0 )
+            snprintf( error_string, sizeof(error_string), "error %d", ret );
+        msg_Err( p_dec, "cannot start codec (%s): %s (%d)", codec->name,
+                 error_string, ret );
         return VLC_EGENERIC;
     }
