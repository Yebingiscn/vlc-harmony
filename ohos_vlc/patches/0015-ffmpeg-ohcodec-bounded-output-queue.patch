+static void *oh_decode_watchdog(void *opaque)
+{
+    AVCodecContext *avctx = opaque;
+    OHCodecDecContext *s = avctx->priv_data;
+    int64_t last_log_us = 0;
+
+    while (atomic_load_explicit(&s->watchdog_running,
+                                memory_order_acquire)) {
+        av_usleep(OH_WATCHDOG_INTERVAL_US);
+        if (!atomic_load_explicit(&s->watchdog_running,
+                                  memory_order_acquire))
+            break;
+
+        const int64_t now = av_gettime_relative();
+        size_t output_queued;
+        unsigned pending;
+        uint64_t dropped;
+        int64_t last_consume;
+
+        ff_mutex_lock(&s->output_mutex);
+        output_queued = av_fifo_can_read(s->output_queue);
+        pending = s->pending_surface_inputs;
+        dropped = s->dropped_surface_outputs;
+        last_consume = s->last_output_consume_us;
+        ff_mutex_unlock(&s->output_mutex);
+
+        if (s->direct_surface_output && output_queued > 0 &&
+            last_consume > 0 && now - last_consume >= OH_WATCHDOG_STALL_US &&
+            now - last_log_us >= 1000000) {
+            size_t input_queued;
+            ff_mutex_lock(&s->input_mutex);
+            input_queued = av_fifo_can_read(s->input_queue);
+            ff_mutex_unlock(&s->input_mutex);
+            av_log(avctx, AV_LOG_WARNING,
+                   "[OHCodecWatchdog] consumer idle=%lldms input=%zu "
+                   "output=%zu pending=%u dropped=%llu\n",
+                   (long long)((now - last_consume) / 1000), input_queued,
+                   output_queued, pending, (unsigned long long)dropped);
+            last_log_us = now;
+        }
+    }
+    return NULL;
+}
