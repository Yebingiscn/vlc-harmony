+int avcodec_ohcodec_set_video_vrr_allowed(AVCodecContext *avctx, int allowed)
+{
+    if (!avctx || !avctx->codec || !avctx->priv_data ||
+        !avctx->codec->wrapper_name ||
+        strcmp(avctx->codec->wrapper_name, "ohcodec"))
+        return AVERROR(ENOSYS);
+    OHCodecDecContext *s = avctx->priv_data;
+    const double fps = av_q2d(avctx->framerate);
+    if (s->vrr_allowed != !!allowed ||
+        (allowed && isfinite(fps) && fps > 30.0 &&
+         fabs(fps - s->configured_frame_rate) > 1e-6)) {
+        s->vrr_allowed = !!allowed;
+        s->playback_policy_pending = true;
+        s->policy_retry_after_us = 0;
+    }
