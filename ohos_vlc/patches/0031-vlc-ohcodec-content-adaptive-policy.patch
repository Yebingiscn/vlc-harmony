diff --git a/include/vlc/libvlc_media_player.h b/include/vlc/libvlc_media_player.h
index b997e79..3e648a7 100644
--- a/include/vlc/libvlc_media_player.h
+++ b/include/vlc/libvlc_media_player.h
@@ -612,6 +612,12 @@ LIBVLC_API void libvlc_media_player_set_ohos_nativewindow_ptr( libvlc_media_play
 LIBVLC_API void libvlc_media_player_set_ohos_osd_nativewindow_ptr( libvlc_media_player_t *p_mi,
                                                                   void *p_osd_window );
 
+/** Permit content-adaptive video refresh in an idle full-screen OHCodec scene.
+ * Defaults to false; has no effect on software or indirect Buffer output.
+ */
+LIBVLC_API void libvlc_media_player_set_ohos_video_vrr_allowed(
+    libvlc_media_player_t *p_mi, bool allowed );
+
 LIBVLC_API void libvlc_video_set_ohos_window_size( libvlc_media_player_t *p_mi,
                                                    unsigned width,
                                                    unsigned height );
diff --git a/modules/codec/avcodec/video.c b/modules/codec/avcodec/video.c
index 2f3ca1a..764382f 100644
--- a/modules/codec/avcodec/video.c
+++ b/modules/codec/avcodec/video.c
@@ -184,6 +184,9 @@ static void ohos_update_playback_speed(decoder_t *p_dec)
         strcmp(codec->wrapper_name, "ohcodec") != 0)
         return;
 
+    avcodec_ohcodec_set_video_vrr_allowed(p_sys->p_context,
+        var_InheritBool(p_dec, "ohcodec-video-vrr-allowed"));
+
     const int display_rate = decoder_GetDisplayRate(p_dec);
     if (display_rate <= 0 || display_rate == p_sys->i_ohos_last_display_rate)
         return;
@@ -524,6 +527,14 @@ static int OpenVideoCodec( decoder_t *p_dec )
         ctx->flags |= AV_CODEC_FLAG_LOW_DELAY;
     }
 
+    /* Advertise the actual source cadence before OHCodec Configure. This is
+     * metadata for content-adaptive refresh, not a fixed screen refresh hint. */
+#ifdef HAVE_OHOS
+    if( codec->wrapper_name && !strcmp(codec->wrapper_name, "ohcodec") &&
+        p_dec->fmt_in.video.i_frame_rate && p_dec->fmt_in.video.i_frame_rate_base )
+        ctx->framerate = (AVRational){ p_dec->fmt_in.video.i_frame_rate,
+                                      p_dec->fmt_in.video.i_frame_rate_base };
+#endif
     post_mt( p_sys );
     ret = ffmpeg_OpenCodec( p_dec, ctx, codec );
     wait_mt( p_sys );
