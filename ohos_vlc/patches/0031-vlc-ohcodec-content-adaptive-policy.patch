diff --git a/lib/media_player.c b/lib/media_player.c
index 0748a84..aa0018f 100644
--- a/lib/media_player.c
+++ b/lib/media_player.c
@@ -649,6 +649,8 @@ libvlc_media_player_new( libvlc_instance_t *instance )
 #ifdef __OHOS__
     var_Create (mp, "drawable-ohos-nativewindow-ptr", VLC_VAR_ADDRESS);
     var_Create (mp, "drawable-ohos-osd-nativewindow-ptr", VLC_VAR_ADDRESS);
+    /* Opt-in only while the UI reports an idle full-screen video scene. */
+    var_Create (mp, "ohcodec-video-vrr-allowed", VLC_VAR_BOOL);
 #endif
 #ifdef HAVE_EVAS
     var_Create (mp, "drawable-evasobject", VLC_VAR_ADDRESS);
@@ -1287,6 +1289,19 @@ void libvlc_media_player_set_ohos_nativewindow_ptr( libvlc_media_player_t *p_mi,
 #endif
 }
 
+void libvlc_media_player_set_ohos_video_vrr_allowed( libvlc_media_player_t *p_mi,
+                                                   bool allowed )
+{
+    assert (p_mi != NULL);
+#ifdef __OHOS__
+    /* Decoder reads this inherited variable on its own thread. No flush or
+     * restart is needed and the UI never calls the hardware decoder directly. */
+    var_SetBool (p_mi, "ohcodec-video-vrr-allowed", allowed);
+#else
+    (void) allowed;
+#endif
+}
+
 void libvlc_media_player_set_ohos_osd_nativewindow_ptr( libvlc_media_player_t *p_mi,
                                                        void *p_osd_window )
 {
