@@ -190,6 +190,7 @@ libvlc_media_player_set_agl
 libvlc_media_player_set_android_context
 libvlc_media_player_set_ohos_nativewindow_ptr
 libvlc_media_player_set_ohos_osd_nativewindow_ptr
