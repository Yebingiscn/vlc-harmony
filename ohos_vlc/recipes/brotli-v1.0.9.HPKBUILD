# Based on Lycium's brotli recipe. Use the official upstream and retry the
# shallow tag clone so a transient mirror/TLS failure does not abort the build.
pkgname=brotli
pkgver=v1.0.9
pkgrel=1
pkgdesc="Brotli compression library"
url="https://github.com/google/brotli"
archs=("armeabi-v7a" "arm64-v8a" "x86_64")
license=("MIT")
depends=()
makedepends=()

source="https://github.com/google/brotli.git"
autounpack=false
downloadpackage=false
clonsrcflag=true

builddir=$pkgname-$pkgver
packagename=$builddir.zip
brotli_commit=e61745a6b7add50d380cfd7d3883dd6c62fc2c71

prepare() {
    if $clonsrcflag; then
        local attempt
        rm -rf "$builddir"
        for attempt in 1 2 3; do
            if git clone --depth=1 --branch "$pkgver" "$source" "$builddir"; then
                break
            fi
            rm -rf "$builddir"
            if [ "$attempt" -eq 3 ]; then
                return 1
            fi
            sleep $((attempt * 5))
        done
        if [ "$(git -C "$builddir" rev-parse HEAD)" != "$brotli_commit" ]; then
            echo "ERROR: brotli $pkgver resolved to an unexpected commit"
            return 1
        fi
        clonsrcflag=false
    fi
    mkdir -p "$builddir/$ARCH-build"
}

build() {
    local LOCAL_CFLAGS="-O3 -fstack-protector-strong -fPIC"
    local LOCAL_CXXFLAGS="-O3 -fstack-protector-strong -fPIC"
    local LOCAL_LDFLAGS="-Wl,-z,relro,-z,now -Wl,--disable-new-dtags -s"

    cd "$builddir"
    PKG_CONFIG_LIBDIR="${pkgconfigpath}" \
    ${OHOS_SDK}/native/build-tools/cmake/bin/cmake "$@" \
        -DOHOS_ARCH="$ARCH" \
        -DCMAKE_C_FLAGS="$LOCAL_CFLAGS" \
        -DCMAKE_CXX_FLAGS="$LOCAL_CXXFLAGS" \
        -DCMAKE_SHARED_LINKER_FLAGS="$LOCAL_LDFLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="$LOCAL_LDFLAGS" \
        -DCMAKE_SKIP_RPATH=TRUE \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -DCMAKE_C_FLAGS_RELEASE="-O3 -DNDEBUG" \
        -B"$ARCH-build" -S./ -L > "$buildlog" 2>&1

    $MAKE VERBOSE=1 -C "$ARCH-build" >> "$buildlog" 2>&1
    local ret=$?
    cd "$OLDPWD"
    return $ret
}

package() {
    cd "$builddir"
    $MAKE VERBOSE=1 -C "$ARCH-build" install >> "$buildlog" 2>&1
    cd "$OLDPWD"
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf "${PWD}/$builddir"
}
