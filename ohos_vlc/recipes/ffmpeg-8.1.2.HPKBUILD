# This recipe replaces Lycium's legacy FFmpeg-surface-dev fork with upstream
# FFmpeg 8.1.2 plus the audited OHCodec patch subset used by libmpvnative.
pkgname=FFmpeg
pkgver=8.1.2
pkgrel=0
pkgdesc="FFmpeg 8.1.2 with OpenHarmony OHCodec zero-copy decoding"
url="https://ffmpeg.org/"
archs=("arm64-v8a")
license=("LGPL-2.1-or-later")
depends=("openssl_3.4.3" "libvorbis" "libogg" "openh264" "dav1d" "lame" "freetype2" "zlib" "bzip2_1_0_8" "brotli" "libpng" "harfbuzz" "fribidi" "libxml2" "fontconfig" "opus")
makedepends=()

autounpack=false
downloadpackage=false
buildtools="configure"

builddir=$pkgname
packagename=$builddir.zip
source envset.sh
cloneflag=true
arch=

prepare() {
    if $cloneflag
    then
        git clone --branch n8.1.2 --depth=1 https://github.com/FFmpeg/FFmpeg.git $builddir
        if [ $? -ne 0 ]; then
            return -1
        fi
        if [ "$(git -C $builddir rev-parse HEAD)" != "38b88335f99e76ed89ff3c93f877fdefce736c13" ]; then
            echo "ERROR: FFmpeg n8.1.2 resolved to an unexpected commit"
            return -1
        fi
        for patch_name in \
            0002-ffmpeg-support-OHCodec-zero-copy-decode.patch \
            0003-ffmpeg-tune-OHCodec-decoder-frame-rate.patch \
            0006-avcodec-ohcodec-auto-vrr-smart-fluency.patch \
            0007-avcodec-ohcodec-fix-buffer-ownership-and-input-splitting.patch \
            0009-avcodec-ohcodec-preserve-dovi-metadata.patch \
            0010-avcodec-ohcodec-gate-dovi-metadata-parsing.patch \
            0011-ffmpeg-ohcodec-system-refresh.patch
        do
            git -C $builddir apply --check "../$patch_name" || return -1
            git -C $builddir apply "../$patch_name" || return -1
        done
        cloneflag=false
    fi

    cp -rf $builddir/ $builddir-$ARCH-build/
    if [ "$ARCH" = "arm64-v8a" ]
    then
        setarm64ENV
        arch=aarch64
    else
        echo "${ARCH} not support"
        return -1
    fi

    export LDFLAGS="$LYCIUM_ROOT/usr/libogg/$ARCH/lib/libogg.a -L$LYCIUM_ROOT/usr/lame/$ARCH/lib/ \
                    -L$LYCIUM_ROOT/usr/libvorbis/$ARCH/lib/ -lvorbis \
                    -L$LYCIUM_ROOT/usr/bzip2_1_0_8/$ARCH/lib $LDFLAGS"
    # FFmpeg 8 probes <libxml2/libxml/xmlversion.h>, while libxml2.pc adds
    # include/libxml2 for the conventional <libxml/...> form. Add the parent
    # include directory as well so the cross-compile probe resolves both.
    export CFLAGS="-I$LYCIUM_ROOT/usr/lame/$ARCH/include/ \
                   -I$LYCIUM_ROOT/usr/bzip2_1_0_8/$ARCH/include \
                   -I$LYCIUM_ROOT/usr/libxml2/$ARCH/include $CFLAGS"
}

build() {
    cd $builddir-$ARCH-build
    PKG_CONFIG_LIBDIR="${pkgconfigpath}" ./configure "$@" \
        --prefix="$LYCIUM_ROOT/usr/$pkgname/$ARCH" \
        --disable-debug --disable-doc --disable-programs \
        --enable-cross-compile --enable-neon --enable-asm --disable-x86asm \
        --disable-vulkan --enable-static --enable-shared --enable-pic \
        --enable-version3 --enable-network --enable-protocols \
        --enable-openssl --enable-zlib --enable-bzlib \
        --enable-libdav1d --enable-libopenh264 --enable-libvorbis \
        --enable-libmp3lame --enable-libfreetype --enable-libharfbuzz \
        --enable-libfribidi --enable-libfontconfig --enable-libopus \
        --enable-libxml2 --enable-ohcodec \
        --target-os=linux --host-os=linux \
        --arch=$arch --cc=${CC} --cxx=${CXX} --ld=${CC} --strip=${STRIP} \
        --sysroot=${OHOS_SDK}/native/sysroot > $buildlog 2>&1
    ret=$?
    if [ $ret -ne 0 ]; then
        cd $OLDPWD
        return $ret
    fi
    $MAKE V=1 >> $buildlog 2>&1
    ret=$?
    cd $OLDPWD
    return $ret
}

package() {
    cd $builddir-$ARCH-build
    $MAKE install >> $buildlog 2>&1
    cd $OLDPWD
    unset arch
    unsetarm64ENV
}

check() {
    echo "The test must be on an OpenHarmony device!"
}

cleanbuild() {
    rm -rf ${PWD}/$builddir-arm64-v8a-build
}
